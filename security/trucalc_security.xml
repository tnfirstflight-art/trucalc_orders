<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_trucalc_evaluations"
            model="ir.module.category">
        <field name="name">TruCalc Evaluations</field>
        <field name="sequence">15</field>
    </record>

    <record id="privilege_trucalc_internal_role"
            model="res.groups.privilege">
        <field name="name">Role</field>
        <field name="category_id"
               ref="module_category_trucalc_evaluations"/>
    </record>

    <!-- ================================================================
         TRUCALC INTERNAL USER GROUPS

         These groups are for TruCalc personnel with Odoo backend access.
         There are exactly three TruCalc internal roles.
         ================================================================ -->

    <record id="group_trucalc_admin" model="res.groups">
        <field name="name">TruCalc Administrator</field>
        <field name="sequence">10</field>
        <field name="privilege_id"
               ref="privilege_trucalc_internal_role"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_trucalc_operations" model="res.groups">
        <field name="name">TruCalc Operations</field>
        <field name="sequence">20</field>
        <field name="privilege_id"
               ref="privilege_trucalc_internal_role"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_trucalc_reviewer" model="res.groups">
        <field name="name">TruCalc Reviewer</field>
        <field name="sequence">30</field>
        <field name="privilege_id"
               ref="privilege_trucalc_internal_role"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>


    <!-- ================================================================
         BANK PORTAL USER GROUPS

         Bank users are external Odoo portal users. They do not receive
         normal Odoo backend access.

         Bank authorization and tenant isolation will be implemented in
         later security passes.
         ================================================================ -->

    <record id="group_bank_admin" model="res.groups">
        <field name="name">TruCalc Bank Administrator</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_bank_requestor" model="res.groups">
        <field name="name">TruCalc Bank Requestor</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_bank_view_only" model="res.groups">
        <field name="name">TruCalc Bank View-Only</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>


    <!-- ================================================================
         VENDOR PORTAL USER GROUP

         Vendors are external Odoo portal users.

         Vendor-specific authorization and record isolation will be
         implemented in later security passes.
         ================================================================ -->

    <record id="group_vendor_portal" model="res.groups">
        <field name="name">TruCalc Vendor Portal User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>


    <!-- ================================================================
         EXISTING COMPANY ORDER RULE

         IMPORTANT:
         This rule is intentionally preserved unchanged during Pass 1.

         It currently applies to base.group_user. It will be replaced
         during the ACL / record-rule hardening passes after the new
         security architecture is established and tested.
         ================================================================ -->

    <record id="rule_company_orders" model="ir.rule">
        <field name="name">Company Orders</field>
        <field name="model_id" ref="model_trucalc_order"/>
        <field name="domain_force">
            [('company_id', 'in', user.company_ids.ids)]
        </field>
        <field name="groups"
               eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
