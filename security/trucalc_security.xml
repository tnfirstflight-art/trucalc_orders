<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_trucalc_evaluations"
            model="ir.module.category">
        <field name="name">TruCalc Evaluations</field>
        <field name="sequence">15</field>
    </record>

    <record id="privilege_trucalc_internal_role"
            model="res.groups.privilege">
        <field name="name">Role</field>
        <field name="category_id"
               ref="module_category_trucalc_evaluations"/>
    </record>

    <record id="privilege_trucalc_reviewer_authorization"
            model="res.groups.privilege">
        <field name="name">Reviewer Authorization</field>
        <field name="sequence">20</field>
        <field name="category_id"
               ref="module_category_trucalc_evaluations"/>
    </record>

    <!-- ================================================================
         TRUCALC INTERNAL USER GROUPS

         These groups are for TruCalc personnel with Odoo backend access.
         Administrator and Operations are mutually exclusive normal roles.
         Reviewer authorization is an additive internal capability.
         ================================================================ -->

    <record id="group_trucalc_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">10</field>
        <field name="privilege_id"
               ref="privilege_trucalc_internal_role"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_trucalc_operations" model="res.groups">
        <field name="name">Operations</field>
        <field name="sequence">20</field>
        <field name="privilege_id"
               ref="privilege_trucalc_internal_role"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_trucalc_reviewer" model="res.groups">
        <field name="name">TruCalc Reviewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id"
               ref="privilege_trucalc_reviewer_authorization"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>


    <!-- ================================================================
         BANK PORTAL USER GROUPS

         Bank users are external Odoo portal users. They do not receive
         normal Odoo backend access.

         Bank authorization and tenant isolation will be implemented in
         later security passes.
         ================================================================ -->

    <record id="group_bank_admin" model="res.groups">
        <field name="name">TruCalc Bank Administrator</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_bank_requestor" model="res.groups">
        <field name="name">TruCalc Bank Requestor</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_bank_view_only" model="res.groups">
        <field name="name">TruCalc Bank View-Only</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>


    <!-- ================================================================
         VENDOR PORTAL USER GROUP

         Vendors are external Odoo portal users.

         Vendor-specific authorization and record isolation will be
         implemented in later security passes.
         ================================================================ -->

    <record id="group_vendor_portal" model="res.groups">
        <field name="name">TruCalc Vendor Portal User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>


    <record id="rule_company_orders" model="ir.rule">
        <field name="name">Operations Submitted Company Orders</field>
        <field name="model_id" ref="model_trucalc_order"/>
        <field name="domain_force">
            [('company_id', 'in', user.company_ids.ids), ('status', '!=', 'draft')]
        </field>
        <field name="groups" eval="[(6, 0, [ref('group_trucalc_operations')])]"/>
    </record>

    <record id="rule_admin_orders_read" model="ir.rule">
        <field name="name">Administrator Orders and Draft Support Read</field>
        <field name="model_id" ref="model_trucalc_order"/>
        <field name="domain_force">
            ['|', ('status', '=', 'draft'), ('company_id', 'in', user.company_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('group_trucalc_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_admin_orders_mutation" model="ir.rule">
        <field name="name">Administrator Submitted Company Order Mutation</field>
        <field name="model_id" ref="model_trucalc_order"/>
        <field name="domain_force">
            [('company_id', 'in', user.company_ids.ids), ('status', '!=', 'draft')]
        </field>
        <field name="groups" eval="[(4, ref('group_trucalc_admin'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_reviewer_assigned_orders" model="ir.rule">
        <field name="name">Reviewer Assigned Orders</field>
        <field name="model_id" ref="model_trucalc_order"/>
        <field name="domain_force">
            [('reviewer_user_id', '=', user.id),
             ('status', 'in', ('reviewer_assigned', 'under_review', 'completed'))]
        </field>
        <field name="groups" eval="[(4, ref('group_trucalc_reviewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_bank_company_orders" model="ir.rule">
        <field name="name">Bank Administrator Company Orders and Drafts</field>
        <field name="model_id" ref="model_trucalc_order"/>
        <field name="domain_force">
            [('company_id', '=', user.trucalc_bank_company_id.id or 0)]
        </field>
        <field name="groups" eval="[(6, 0, [ref('group_bank_admin')])]"/>
    </record>

    <record id="rule_bank_requestor_orders" model="ir.rule">
        <field name="name">Bank Requestor Submitted and Own Draft Orders</field>
        <field name="model_id" ref="model_trucalc_order"/>
        <field name="domain_force">
            [('company_id', '=', user.trucalc_bank_company_id.id or 0),
             '|', ('status', '!=', 'draft'), ('requestor_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_bank_requestor'))]"/>
    </record>

    <record id="rule_bank_view_only_orders" model="ir.rule">
        <field name="name">Bank View-Only Submitted Orders</field>
        <field name="model_id" ref="model_trucalc_order"/>
        <field name="domain_force">
            [('company_id', '=', user.trucalc_bank_company_id.id or 0),
             ('status', '!=', 'draft')]
        </field>
        <field name="groups" eval="[(4, ref('group_bank_view_only'))]"/>
    </record>

    <record id="rule_vendor_order_projection" model="ir.rule">
        <field name="name">Vendor Order Projection</field>
        <field name="model_id" ref="model_trucalc_vendor_order"/>
        <field name="domain_force">
            [('vendor_id', '=', user.trucalc_vendor_id.id or 0)]
        </field>
        <field name="groups"
               eval="[(4, ref('group_vendor_portal'))]"/>
    </record>

    <record id="rule_vendor_engagement_company" model="ir.rule">
        <field name="name">Vendor Engagement Company</field>
        <field name="model_id" ref="model_trucalc_vendor_engagement"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups"
               eval="[(4, ref('group_trucalc_admin')), (4, ref('group_trucalc_operations'))]"/>
    </record>

    <record id="rule_vendor_engagement_event_company" model="ir.rule">
        <field name="name">Vendor Engagement Event Company</field>
        <field name="model_id" ref="model_trucalc_vendor_engagement_event"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups"
               eval="[(4, ref('group_trucalc_admin')), (4, ref('group_trucalc_operations'))]"/>
    </record>

    <record id="rule_trucalc_document_company" model="ir.rule">
        <field name="name">TruCalc Document Company</field>
        <field name="model_id" ref="model_trucalc_document"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_trucalc_admin'), ref('group_trucalc_operations')])]"/>
    </record>

    <record id="rule_trucalc_document_event_company" model="ir.rule">
        <field name="name">TruCalc Document Event Company</field>
        <field name="model_id" ref="model_trucalc_document_event"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_trucalc_admin')), (4, ref('group_trucalc_operations'))]"/>
    </record>

    <record id="rule_order_lifecycle_event_company" model="ir.rule">
        <field name="name">Order Lifecycle Event Company</field>
        <field name="model_id" ref="model_trucalc_order_lifecycle_event"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_trucalc_admin')), (4, ref('group_trucalc_operations'))]"/>
    </record>

    <record id="rule_vendor_deliverable_admin_company" model="ir.rule">
        <field name="name">Administrator Vendor Deliverables by Company</field>
        <field name="model_id" ref="model_trucalc_vendor_deliverable"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_trucalc_admin'))]"/>
    </record>

    <record id="rule_vendor_deliverable_operations_company" model="ir.rule">
        <field name="name">Operations Vendor Deliverables by Company</field>
        <field name="model_id" ref="model_trucalc_vendor_deliverable"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_trucalc_operations'))]"/>
    </record>

    <record id="rule_vendor_deliverable_reviewer_assignment" model="ir.rule">
        <field name="name">Assigned Reviewer Valuations</field>
        <field name="model_id" ref="model_trucalc_vendor_deliverable"/>
        <field name="domain_force">
            [('artifact_type', '=', 'valuation'),
             ('order_id.reviewer_user_id', '=', user.id),
             ('order_id.status', 'in', ('reviewer_assigned', 'under_review'))]
        </field>
        <field name="groups" eval="[(4, ref('group_trucalc_reviewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_order_lifecycle_event_reviewer_assignment" model="ir.rule">
        <field name="name">Assigned Reviewer Lifecycle Events</field>
        <field name="model_id" ref="model_trucalc_order_lifecycle_event"/>
        <field name="domain_force">
            [('order_id.reviewer_user_id', '=', user.id),
             ('order_id.status', 'in', ('reviewer_assigned', 'under_review'))]
        </field>
        <field name="groups" eval="[(4, ref('group_trucalc_reviewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- These legacy ACL records must be deleted during upgrade; omitting their
         CSV rows alone would leave the already-installed database rows active. -->
    <delete id="access_trucalc_order_vendor_portal" model="ir.model.access"/>
    <delete id="access_trucalc_document_vendor_portal" model="ir.model.access"/>
    <delete id="access_trucalc_document_bank_admin" model="ir.model.access"/>
    <delete id="access_trucalc_document_bank_requestor" model="ir.model.access"/>
    <delete id="access_trucalc_document_bank_view_only" model="ir.model.access"/>
    <delete id="access_trucalc_bid_vendor_portal" model="ir.model.access"/>
    <delete id="access_trucalc_document_reviewer" model="ir.model.access"/>
    <!-- Reviewer deliverable/event access is restored narrowly above for 4D.3. -->
    <delete id="rule_reviewer_required_partners" model="ir.rule"/>
    <delete id="rule_trucalc_document_reviewer_assignment" model="ir.rule"/>

</odoo>
