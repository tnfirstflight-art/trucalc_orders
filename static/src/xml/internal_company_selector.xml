<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.SwitchCompanyMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_switch_company_menu')]" position="attributes">
            <attribute name="t-if">trucalcCompanySelectorVisible</attribute>
        </xpath>
    </t>

    <t t-inherit="web.MobileSwitchCompanyMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_burger_menu_companies')]" position="attributes">
            <attribute name="t-if">trucalcCompanySelectorVisible</attribute>
        </xpath>
    </t>
</templates>
