<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_bank_user_provision_form" model="ir.ui.view">
        <field name="name">trucalc.bank.user.provision.form</field>
        <field name="model">trucalc.bank.user.provision</field>
        <field name="arch" type="xml">
            <form string="Add Bank User" create="false" edit="true" delete="false">
                <group>
                    <field name="bank_company_id" options="{'no_open': True}"/>
                    <field name="name"/>
                    <field name="login"/>
                    <field name="phone"/>
                    <field name="role"/>
                    <field name="active"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Create User" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_trucalc_bank_user_email_change_form" model="ir.ui.view">
        <field name="name">trucalc.bank.user.email.change.form</field>
        <field name="model">trucalc.bank.user.email.change</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <form string="Change Bank User Email" create="false" edit="true" delete="false">
                <field name="owner_user_id" invisible="1"/>
                <field name="pending_invitation" invisible="1"/>
                <group>
                    <field name="bank_company_id" options="{'no_open': True}"/>
                    <field name="target_user_id" options="{'no_open': True}"/>
                    <field name="current_login"/>
                    <field name="new_login" placeholder="user@example.com"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not pending_invitation">
                    Changing the email will invalidate the current invitation. Send a new invitation after saving.
                </div>
                <group invisible="not pending_invitation">
                    <field name="acknowledge_invitation_invalidation" required="pending_invitation"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Change Email" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_trucalc_bank_user_edit_form" model="ir.ui.view">
        <field name="name">trucalc.bank.user.edit.form</field>
        <field name="model">trucalc.bank.user.edit</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <form string="Edit Bank User" create="false" edit="true" delete="false">
                <field name="owner_user_id" invisible="1"/>
                <group>
                    <field name="bank_company_id" options="{'no_open': True}"/>
                    <field name="target_user_id" options="{'no_open': True}"/>
                    <field name="login"/>
                    <field name="name"/>
                    <field name="phone"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_trucalc_bank_user_role_change_form" model="ir.ui.view">
        <field name="name">trucalc.bank.user.role.change.form</field>
        <field name="model">trucalc.bank.user.role.change</field>
        <field name="arch" type="xml">
            <form string="Change Bank Role" create="false" edit="true" delete="false">
                <group>
                    <field name="bank_company_id" options="{'no_open': True}"/>
                    <field name="target_user_id" options="{'no_open': True}"/>
                    <field name="role"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Change Role" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_trucalc_bank_user_new" model="ir.actions.act_window">
        <field name="name">Add Bank User</field>
        <field name="res_model">trucalc.bank.user.provision</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_trucalc_bank_user_provision_form"/>
        <field name="target">new</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
    </record>

    <record id="view_trucalc_bank_user_manage_form" model="ir.ui.view">
        <field name="name">trucalc.bank.user.manage.form</field>
        <field name="model">trucalc.bank.user.manage</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <form string="Manage Bank User" create="false" edit="true" delete="false">
                <field name="owner_user_id" invisible="1"/>
                <field name="management_row_id" invisible="1"/>
                <field name="target_user_id" invisible="1"/>
                <field name="email_changed" invisible="1"/>
                <field name="pending_account_link" invisible="1"/>
                <field name="requires_link_acknowledgement" invisible="1"/>
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="bank_company_id" options="{'no_open': True}"/>
                            <field name="name" readonly="not user_active"/>
                            <field name="login" readonly="not user_active"
                                   placeholder="user@example.com"/>
                            <field name="phone" readonly="not user_active"/>
                        </group>
                        <group string="Access and Account Status">
                            <field name="role" readonly="not user_active"/>
                            <field name="user_active"/>
                            <field name="account_state"/>
                            <field name="last_login"/>
                            <field name="recent_email_kind"/>
                            <field name="recent_email_outcome"/>
                            <field name="recent_email_at"/>
                            <field name="recent_mail_state" optional="hide"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not requires_link_acknowledgement">
                        Changing the email will invalidate the current invitation or password-reset link.
                        Save first, then use the account action appropriate to the refreshed state.
                    </div>
                    <group invisible="not requires_link_acknowledgement">
                        <field name="acknowledge_account_link_invalidation"
                               required="requires_link_acknowledgement"/>
                    </group>
                    <group string="Account Actions">
                        <button name="action_send_invitation" type="object"
                                string="Send Invitation" class="btn-secondary"
                                invisible="account_state != 'never_invited'"/>
                        <button name="action_resend_invitation" type="object"
                                string="Resend Invitation" class="btn-secondary"
                                invisible="account_state not in ('invitation_pending', 'invitation_expired')"/>
                        <button name="action_send_password_reset" type="object"
                                string="Send Password Reset" class="btn-secondary"
                                invisible="account_state not in ('confirmed', 'reset_pending')"/>
                        <button name="action_reactivate" type="object"
                                string="Reactivate" class="btn-secondary"
                                invisible="account_state != 'inactive'"/>
                        <button name="action_deactivate" type="object"
                                string="Deactivate" class="btn-secondary"
                                invisible="not user_active"
                                confirm="Deactivate this Bank user? Historical Orders, documents, and audit attribution will be preserved."/>
                    </group>
                    <notebook>
                        <page string="Administration History">
                            <field name="account_audit_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="event_at"/>
                                    <field name="event_type"/>
                                    <field name="actor_user_id"/>
                                    <field name="mail_state" optional="show"/>
                                    <field name="new_status" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save Changes"
                            class="btn-primary" invisible="not user_active"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_trucalc_bank_user_management_list" model="ir.ui.view">
        <field name="name">trucalc.bank.user.management.list</field>
        <field name="model">trucalc.bank.user.management</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <list string="Bank Users" create="false" edit="false" delete="false"
                  open_form_view="false">
                <header>
                    <button name="%(action_trucalc_bank_user_new)d" type="action"
                            string="Add Bank User" class="btn-primary" display="always"
                            context="{'default_bank_company_id': context.get('active_bank_company_id'), 'trucalc_locked_bank_company_id': context.get('active_bank_company_id')}"/>
                </header>
                <field name="owner_user_id" column_invisible="True"/>
                <field name="target_user_id" column_invisible="True"/>
                <field name="name" widget="trucalc_bank_user_manage_link"/>
                <field name="login"/>
                <field name="phone" optional="show"/>
                <field name="role"/>
                <field name="user_active"/>
                <field name="bank_company_id" options="{'no_open': True}"/>
                <field name="invitation_state"/>
            </list>
        </field>
    </record>
</odoo>
