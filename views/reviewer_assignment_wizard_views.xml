<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_reviewer_assignment_wizard_form" model="ir.ui.view">
        <field name="name">trucalc.reviewer.assignment.wizard.form</field>
        <field name="model">trucalc.reviewer.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Reviewer">
                <group>
                    <field name="order_id"/>
                    <field name="reviewer_user_id"/>
                    <field name="reason" required="order_id.status != 'report_received'"
                           invisible="order_id.status == 'report_received'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
