<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_document_tag_list" model="ir.ui.view">
        <field name="name">trucalc.document.tag.list</field><field name="model">trucalc.document.tag</field>
        <field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="active"/></list></field>
    </record>
    <record id="view_trucalc_document_tag_form" model="ir.ui.view">
        <field name="name">trucalc.document.tag.form</field><field name="model">trucalc.document.tag</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="active"/><field name="sequence"/></group></sheet></form></field>
    </record>
    <record id="action_trucalc_document_tags" model="ir.actions.act_window">
        <field name="name">Document Tags</field><field name="res_model">trucalc.document.tag</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_trucalc_configuration" name="Configuration" parent="menu_trucalc_root" sequence="90" groups="trucalc_orders.group_trucalc_admin"/>
    <record id="menu_trucalc_draft_support" model="ir.ui.menu">
        <field name="name">Bank Draft Support</field>
        <field name="parent_id" ref="menu_trucalc_root"/>
        <field name="action" ref="action_trucalc_draft_support"/>
        <field name="sequence" eval="20"/>
        <field name="group_ids" eval="[Command.set([ref('group_trucalc_admin')])]"/>
        <field name="active" eval="False"/>
    </record>
    <menuitem id="menu_trucalc_document_tags" name="Document Tags" parent="menu_trucalc_configuration"
              action="action_trucalc_document_tags" sequence="40"
              groups="trucalc_orders.group_trucalc_admin"/>
</odoo>
