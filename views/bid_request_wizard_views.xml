<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_bid_request_wizard_form" model="ir.ui.view">
        <field name="name">trucalc.bid.request.wizard.form</field>
        <field name="model">trucalc.bid.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Vendor Solicitation">
                <group>
                    <field name="order_id"/>
                    <field name="mode" invisible="1"/>
                    <field name="response_deadline"
                           widget="datetime"
                           options="{'show_time': True, 'show_seconds': False, 'rounding': 15}"
                           readonly="mode == 'manage'"
                           required="mode == 'request'"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" editable="bottom">
                        <field name="selected" widget="boolean_toggle"
                               readonly="already_invited"/>
                        <field name="vendor_id" force_save="1"
                               options="{'no_open': True}"/>
                        <field name="standard_fee_display" force_save="1"/>
                        <field name="already_invited" force_save="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_trucalc_bid_deadline_wizard_form" model="ir.ui.view">
        <field name="name">trucalc.bid.deadline.wizard.form</field>
        <field name="model">trucalc.bid.deadline.wizard</field>
        <field name="arch" type="xml">
            <form string="Extend Bid Deadline">
                <group>
                    <field name="order_id"/>
                    <field name="current_deadline" widget="datetime"
                           options="{'show_time': True, 'show_seconds': False, 'rounding': 15}"/>
                    <field name="new_deadline" widget="datetime"
                           options="{'show_time': True, 'show_seconds': False, 'rounding': 15}"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Extend Deadline" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
