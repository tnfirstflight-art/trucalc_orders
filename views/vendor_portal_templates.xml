<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_trucalc_orders"
              name="My TruCalc Orders"
              inherit_id="portal.portal_my_home"
              priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_vendor_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_vendor_category" position="inside">
            <t t-if="request.env.user.has_group('trucalc_orders.group_vendor_portal')"
               t-call="portal.portal_docs_entry">
                <t t-set="title">My TruCalc Orders</t>
                <t t-set="text">View your authorized TruCalc orders</t>
                <t t-set="url" t-value="'/my/trucalc/orders'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
            <div t-if="request.env.user.has_group('trucalc_orders.group_bank_admin') or request.env.user.has_group('trucalc_orders.group_bank_requestor') or request.env.user.has_group('trucalc_orders.group_bank_view_only')"
                 class="o_trucalc_bank_portal">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">My TruCalc Requests</t>
                    <t t-set="text">View your Bank's authorized TruCalc requests</t>
                    <t t-set="url" t-value="'/my/trucalc/bank/orders'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>
        </div>
    </template>

    <template id="portal_trucalc_order_breadcrumbs"
              name="TruCalc Order Breadcrumbs"
              inherit_id="portal.portal_breadcrumbs"
              priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name in ('trucalc_orders', 'trucalc_order')"
                t-attf-class="breadcrumb-item #{'active' if page_name == 'trucalc_orders' else ''}">
                <a t-if="page_name == 'trucalc_order'" href="/my/trucalc/orders">
                    My TruCalc Orders
                </a>
                <t t-else="">My TruCalc Orders</t>
            </li>
            <li t-if="page_name == 'trucalc_order'" class="breadcrumb-item active">
                <t t-out="projection.order_number"/>
            </li>
            <li t-if="page_name in ('trucalc_bank_orders', 'trucalc_bank_documents', 'trucalc_bank_order_new')"
                t-attf-class="breadcrumb-item #{'active' if page_name == 'trucalc_bank_orders' else ''}">
                <a t-if="page_name in ('trucalc_bank_documents', 'trucalc_bank_order_new')"
                   href="/my/trucalc/bank/orders">My TruCalc Requests</a>
                <t t-else="">My TruCalc Requests</t>
            </li>
            <li t-if="page_name == 'trucalc_bank_documents'"
                class="breadcrumb-item active">
                <t t-out="order.order_number"/>
            </li>
            <li t-if="page_name == 'trucalc_bank_order_new'" class="breadcrumb-item active">
                New Request
            </li>
        </xpath>
    </template>

    <template id="portal_my_trucalc_orders" name="My TruCalc Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My TruCalc Orders</t>
            </t>

            <div t-if="not projections" class="alert alert-info" role="status">
                You currently have no authorized TruCalc orders.
            </div>

            <t t-if="projections" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Service</th>
                        <th>Borrower</th>
                        <th>Property</th>
                        <th>Status</th>
                        <th>Response</th>
                        <th>Due</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="projections" t-as="projection">
                        <td>
                            <a t-att-href="'/my/trucalc/orders/%s' % projection.order_number">
                                <t t-out="projection.order_number"/>
                            </a>
                        </td>
                        <td><span t-field="projection.service_type"/></td>
                        <td><span t-field="projection.borrower"/></td>
                        <td>
                            <div t-out="projection.property_address"/>
                            <small class="text-muted">
                                <t t-out="projection.city"/>,
                                <t t-out="projection.state"/>
                                <t t-out="projection.zip_code"/>
                            </small>
                        </td>
                        <td>
                            <span t-field="projection.order_status"/>
                            <div t-if="projection.order_status == 'under_review' and projection.review_indicator"
                                 class="text-muted small">
                                <span t-field="projection.review_indicator"/>
                            </div>
                        </td>
                        <td><t t-out="projection.vendor_response_label or '—'"/></td>
                        <td>
                            <span t-if="projection.vendor_phase == 'assignment' and projection.vendor_delivery_date"
                                  t-field="projection.vendor_delivery_date"/>
                            <span t-elif="projection.vendor_phase != 'assignment' and projection.response_deadline"
                                  t-field="projection.response_deadline"/>
                            <span t-else="">—</span>
                        </td>
                    </tr>
                </tbody>
            </t>

            <div t-if="pager" class="d-flex justify-content-center mt-3">
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <template id="portal_my_trucalc_order" name="TruCalc Order">
        <t t-call="portal.portal_layout">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">
                    TruCalc Order <t t-out="projection.order_number"/>
                </h2>
                <a href="/my/trucalc/orders" class="btn btn-outline-secondary">
                    Back to My TruCalc Orders
                </a>
            </div>

            <div class="card">
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Service</dt>
                        <dd class="col-sm-8"><span t-field="projection.service_type"/></dd>

                        <dt class="col-sm-4">Borrower</dt>
                        <dd class="col-sm-8"><span t-field="projection.borrower"/></dd>

                        <dt class="col-sm-4">Property type</dt>
                        <dd class="col-sm-8"><span t-field="projection.property_type"/></dd>

                        <dt class="col-sm-4">Property address</dt>
                        <dd class="col-sm-8">
                            <div t-out="projection.property_address"/>
                            <div>
                                <t t-out="projection.city"/>,
                                <t t-out="projection.state"/>
                                <t t-out="projection.zip_code"/>
                            </div>
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8"><span t-field="projection.order_status"/></dd>

                        <t t-if="projection.inspection_contact_name">
                            <dt class="col-sm-4">Inspection Contact Person</dt>
                            <dd class="col-sm-8"><t t-out="projection.inspection_contact_name"/></dd>
                            <dt class="col-sm-4">Inspection Contact Phone</dt>
                            <dd class="col-sm-8"><t t-out="projection.inspection_contact_phone_display"/></dd>
                            <dt class="col-sm-4">Inspection Contact Email</dt>
                            <dd class="col-sm-8"><t t-out="projection.inspection_contact_email"/></dd>
                        </t>

                        <dt t-if="projection.response_deadline" class="col-sm-4">
                            Response deadline
                        </dt>
                        <dd t-if="projection.response_deadline" class="col-sm-8">
                            <span t-field="projection.response_deadline"/>
                        </dd>

                        <dt t-if="projection.vendor_phase == 'invitation'" class="col-sm-4">
                            Standard fee
                        </dt>
                        <dd t-if="projection.vendor_phase == 'invitation'" class="col-sm-8">
                            <span t-if="projection.solicitation_standard_fee is not False"
                                  t-field="projection.solicitation_standard_fee"
                                  t-options="{'widget': 'monetary', 'display_currency': projection.currency_id}"/>
                            <span t-else="">Not recorded for this legacy invitation</span>
                        </dd>

                        <dt t-if="projection.vendor_phase in ('invitation', 'declined_history')"
                            class="col-sm-4">Requested delivery date</dt>
                        <dd t-if="projection.vendor_phase in ('invitation', 'declined_history')"
                            class="col-sm-8">
                            <span t-if="projection.requested_delivery_date"
                                  t-field="projection.requested_delivery_date"/>
                            <span t-else="">Not recorded for this historical invitation</span>
                        </dd>

                        <dt t-if="projection.is_assigned" class="col-sm-4">Agreed fee</dt>
                        <dd t-if="projection.is_assigned" class="col-sm-8">
                            <span t-field="projection.agreed_vendor_fee"
                                  t-options="{'widget': 'monetary', 'display_currency': projection.currency_id}"/>
                        </dd>

                        <dt t-if="projection.vendor_phase == 'assignment'"
                            class="col-sm-4">Vendor Engaged Date</dt>
                        <dd t-if="projection.vendor_phase == 'assignment'"
                            class="col-sm-8">
                            <span t-field="projection.vendor_engaged_at"
                                  t-options="{'widget': 'date'}"/>
                        </dd>

                        <dt t-if="projection.vendor_phase == 'assignment'"
                            class="col-sm-4">Vendor Delivery Date</dt>
                        <dd t-if="projection.vendor_phase == 'assignment'"
                            class="col-sm-8">
                            <span t-field="projection.vendor_delivery_date"/>
                        </dd>

                        <dt t-if="projection.vendor_phase == 'assignment'"
                            class="col-sm-4">Engagement Response</dt>
                        <dd t-if="projection.vendor_phase == 'assignment'"
                            class="col-sm-8">
                            <t t-out="projection.engagement_response_label or '—'"/>
                        </dd>
                    </dl>
                </div>
            </div>

            <div t-if="response_error" class="alert alert-danger mt-3" role="alert">
                <t t-out="response_error"/>
            </div>

            <div t-if="deliverable_error" class="alert alert-danger mt-3" role="alert">
                <t t-out="deliverable_error"/>
            </div>
            <div t-if="deliverable_submitted" class="alert alert-success mt-3" role="status">
                Vendor deliverable submitted successfully.
            </div>

            <div class="card mt-3">
                <div class="card-header"><strong>Valuation and Invoice</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Valuation Upload:</strong>
                        <a t-if="valuation"
                           t-att-href="'/my/trucalc/orders/%s/deliverables/%s/download' % (projection.order_number, valuation.id)">
                            <t t-out="valuation.filename"/>
                        </a>
                        <span t-if="not valuation" class="text-muted">Not submitted</span>
                        <div t-if="valuation" class="text-muted small">
                            <span>Submitted Date: </span><span t-field="valuation.submitted_at"/>
                            <span class="ms-3">Version: </span><span t-out="valuation.version"/>
                            <span class="ms-3">Status: </span><span t-field="valuation.status"/>
                        </div>
                        <div t-if="valuation_revision_request" class="alert alert-warning mt-2" role="status">
                            <strong>Revision Requested</strong>
                            <p class="mb-1 mt-1" t-out="valuation_revision_request.vendor_revision_instructions"/>
                            <small>Your earlier submission remains preserved. Upload a new PDF below.</small>
                        </div>
                        <form t-if="can_submit_valuation"
                              t-att-action="'/my/trucalc/orders/%s/deliverables/valuation' % projection.order_number"
                              method="post" enctype="multipart/form-data" class="mt-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <label for="valuation_file" class="form-label">
                                Select a Valuation PDF to upload
                            </label>
                            <div class="input-group">
                                <input id="valuation_file" type="file" name="valuation_file"
                                       accept="application/pdf,.pdf"
                                       class="form-control" required="required"/>
                                <button type="submit" class="btn btn-primary">
                                    <t t-if="valuation_revision_request">Submit Revised Valuation</t>
                                    <t t-else="">Submit Valuation</t>
                                </button>
                            </div>
                        </form>
                    </div>

                    <div>
                        <strong>Vendor Invoice:</strong>
                        <a t-if="vendor_invoice"
                           t-att-href="'/my/trucalc/orders/%s/deliverables/%s/download' % (projection.order_number, vendor_invoice.id)">
                            <t t-out="vendor_invoice.filename"/>
                        </a>
                        <span t-if="not vendor_invoice" class="text-muted">Not submitted</span>
                        <div t-if="vendor_invoice" class="text-muted small">
                            <span>Submitted Date: </span><span t-field="vendor_invoice.submitted_at"/>
                            <span class="ms-3">Status: </span><span t-field="vendor_invoice.status"/>
                        </div>
                        <form t-if="can_submit_vendor_invoice"
                              t-att-action="'/my/trucalc/orders/%s/deliverables/vendor-invoice' % projection.order_number"
                              method="post" enctype="multipart/form-data" class="mt-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <label for="vendor_invoice_file" class="form-label">
                                Select a Vendor Invoice PDF to upload
                            </label>
                            <div class="input-group">
                                <input id="vendor_invoice_file" type="file" name="vendor_invoice_file"
                                       accept="application/pdf,.pdf"
                                       class="form-control" required="required"/>
                                <button type="submit" class="btn btn-primary">Submit Vendor Invoice</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header"><strong>Documents</strong></div>
                <div t-if="documents" class="list-group list-group-flush">
                    <a t-foreach="documents" t-as="document"
                       t-att-href="'/my/trucalc/orders/%s/documents/%s/download' % (projection.order_number, document.id)"
                       class="list-group-item list-group-item-action">
                        <t t-out="document.filename"/>
                        <span class="text-muted"> — <t t-out="document.tag_id.name"/></span>
                    </a>
                </div>
                <div t-if="not documents" class="card-body text-muted">
                    No supporting documents are currently available.
                </div>
            </div>

            <div t-if="projection.vendor_phase != 'assignment' and (projection.vendor_phase in ('invitation', 'declined_history') or projection.response_type)"
                 class="card mt-3">
                <div class="card-header"><strong>Vendor Response</strong></div>
                <div class="card-body">
                    <t t-if="projection.vendor_status == 'declined'">
                        <p class="mb-1"><strong>Response Status:</strong> Declined</p>
                        <p t-if="projection.vendor_decline_reason" class="mb-0">
                            <strong>Reason:</strong>
                            <t t-out="projection.vendor_decline_reason"/>
                        </p>
                    </t>
                    <t t-elif="projection.response_type">
                        <dl class="row">
                            <dt class="col-sm-4">Response</dt>
                            <dd class="col-sm-8"><span t-field="projection.response_type"/></dd>
                            <dt class="col-sm-4">Proposed fee</dt>
                            <dd class="col-sm-8">
                                <span t-field="projection.proposed_fee"
                                      t-options="{'widget': 'monetary', 'display_currency': projection.currency_id}"/>
                            </dd>
                            <dt class="col-sm-4">Proposed delivery date</dt>
                            <dd class="col-sm-8"><span t-field="projection.proposed_delivery_date"/></dd>
                            <dt t-if="projection.vendor_comments" class="col-sm-4">Comments</dt>
                            <dd t-if="projection.vendor_comments" class="col-sm-8">
                                <t t-out="projection.vendor_comments"/>
                            </dd>
                            <dt class="col-sm-4">Status</dt>
                            <dd class="col-sm-8"><span t-field="projection.response_status"/></dd>
                        </dl>
                    </t>

                    <div t-if="projection.can_respond">
                        <h5 t-if="projection.response_type">Revise Response</h5>

                        <form t-att-action="'/my/trucalc/orders/%s/response' % projection.order_number"
                              method="post" class="border rounded p-3 mb-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="response_type"
                                   value="standard_terms_accepted"/>
                            <h6>Accept Standard Terms</h6>
                            <p>Accept the displayed Standard Fee and Requested Delivery Date.</p>
                            <button type="submit" class="btn btn-primary">Accept Standard Terms</button>
                        </form>

                        <form t-att-action="'/my/trucalc/orders/%s/response' % projection.order_number"
                              method="post" class="border rounded p-3 mb-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="response_type" value="delivery_date_counter"/>
                            <h6>Accept Fee / Change Delivery Date</h6>
                            <div class="mb-2">
                                <label class="form-label">Proposed Delivery Date</label>
                                <input type="date" name="proposed_delivery_date"
                                       class="form-control" required="required"/>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Vendor Comments</label>
                                <textarea name="comments" class="form-control" rows="2"/>
                            </div>
                            <button type="submit" class="btn btn-primary">Submit Date Change</button>
                        </form>

                        <form t-att-action="'/my/trucalc/orders/%s/response' % projection.order_number"
                              method="post" class="border rounded p-3 mb-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="response_type" value="fee_and_delivery_counter"/>
                            <h6>Counter Fee and Delivery Date</h6>
                            <div class="mb-2">
                                <label class="form-label">Proposed Fee</label>
                                <input type="number" name="proposed_fee" min="0" step="0.01"
                                       class="form-control" required="required"/>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Proposed Delivery Date</label>
                                <input type="date" name="proposed_delivery_date"
                                       class="form-control" required="required"/>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Vendor Comments</label>
                                <textarea name="comments" class="form-control" rows="2"/>
                            </div>
                            <button type="submit" class="btn btn-primary">Submit Counteroffer</button>
                        </form>

                        <form t-if="not projection.response_type"
                              t-att-action="'/my/trucalc/orders/%s/decline' % projection.order_number"
                              method="post" class="border border-danger rounded p-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <h6>Decline Bid Request</h6>
                            <div class="mb-2">
                                <label class="form-label">Decline Reason</label>
                                <textarea name="decline_reason" class="form-control" rows="2"
                                          required="required"/>
                            </div>
                            <button type="submit" class="btn btn-outline-danger">Decline Bid Request</button>
                        </form>
                    </div>
                </div>
            </div>

            <div t-if="projection.vendor_phase == 'assignment'" class="card mt-3">
                <div class="card-header"><strong>Engagement Response</strong></div>
                <div class="card-body">
                    <div t-if="projection.engagement_response_state == 'delivery_change_requested'"
                         class="alert alert-info">
                        <p class="mb-1"><strong>Requested Delivery Date:</strong>
                            <span t-field="projection.pending_requested_delivery_date"/>
                        </p>
                        <p class="mb-0"><strong>Reason / Comments:</strong>
                            <t t-out="projection.pending_request_reason"/>
                        </p>
                        <p class="mt-2 mb-0">
                            TruCalc is reviewing your conditional acceptance request.
                            The current Vendor Delivery Date remains authoritative until approval.
                        </p>
                    </div>
                    <div t-if="projection.engagement_response_state == 'declined'"
                         class="alert alert-secondary">
                        <strong>Decline Reason:</strong>
                        <t t-out="projection.engagement_decline_reason"/>
                    </div>

                    <div t-if="projection.can_accept_engagement"
                         class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-primary"
                                data-bs-toggle="modal" data-bs-target="#accept-engagement-modal">
                            Accept Assignment
                        </button>
                        <button type="button" class="btn btn-outline-primary"
                                data-bs-toggle="modal" data-bs-target="#delivery-change-modal">
                            Request Delivery Change
                        </button>
                        <button type="button" class="btn btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#decline-engagement-modal">
                            Decline Assignment
                        </button>
                    </div>
                </div>
            </div>

            <div t-if="projection.can_accept_engagement" id="accept-engagement-modal"
                 class="modal fade" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog"><div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Accept Assignment</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                aria-label="Close"/>
                    </div>
                    <div class="modal-body">
                        <p>By accepting this assignment, you confirm that you can perform
                           the assignment for the agreed fee and deliver it by the stated
                           Vendor Delivery Date.</p>
                        <dl class="row mb-0">
                            <dt class="col-5">Order Number</dt><dd class="col-7"><t t-out="projection.order_number"/></dd>
                            <dt class="col-5">Service</dt><dd class="col-7"><span t-field="projection.service_type"/></dd>
                            <dt class="col-5">Property</dt><dd class="col-7"><t t-out="projection.property_address"/></dd>
                            <dt class="col-5">Agreed Vendor Fee</dt>
                            <dd class="col-7"><span t-field="projection.agreed_vendor_fee"
                                t-options="{'widget': 'monetary', 'display_currency': projection.currency_id}"/></dd>
                            <dt class="col-5">Vendor Delivery Date</dt>
                            <dd class="col-7"><span t-field="projection.vendor_delivery_date"/></dd>
                        </dl>
                    </div>
                    <form t-att-action="'/my/trucalc/orders/%s/engagement/accept' % projection.order_number"
                          method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Accept Assignment</button>
                        </div>
                    </form>
                </div></div>
            </div>

            <div t-if="projection.can_request_delivery_change" id="delivery-change-modal"
                 class="modal fade" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog"><div class="modal-content">
                    <form t-att-action="'/my/trucalc/orders/%s/engagement/request-delivery-change' % projection.order_number"
                          method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="modal-header"><h5 class="modal-title">Request Delivery Change</h5></div>
                        <div class="modal-body">
                            <p>The agreed Vendor Fee remains unchanged. The current Vendor
                               Delivery Date remains authoritative until TruCalc approves.</p>
                            <div class="mb-3">
                                <label class="form-label">Requested Delivery Date</label>
                                <input type="date" name="requested_delivery_date"
                                       class="form-control" required="required"/>
                            </div>
                            <div>
                                <label class="form-label">Reason / Comments</label>
                                <textarea name="reason" class="form-control" rows="3"
                                          required="required"/>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Submit Request</button>
                        </div>
                    </form>
                </div></div>
            </div>

            <div t-if="projection.can_decline_engagement" id="decline-engagement-modal"
                 class="modal fade" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog"><div class="modal-content">
                    <form t-att-action="'/my/trucalc/orders/%s/engagement/decline' % projection.order_number"
                          method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="modal-header"><h5 class="modal-title">Decline Assignment</h5></div>
                        <div class="modal-body">
                            <p>Declining does not automatically reopen bidding. TruCalc
                               Operations must determine the next action.</p>
                            <label class="form-label">Decline Reason</label>
                            <textarea name="decline_reason" class="form-control" rows="3"
                                      required="required"/>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Decline Assignment</button>
                        </div>
                    </form>
                </div></div>
            </div>
        </t>
    </template>

    <template id="portal_bank_orders" name="Bank TruCalc Orders">
        <t t-call="portal.portal_layout">
            <div class="o_trucalc_bank_portal">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My TruCalc Requests</t>
            </t>
            <div t-if="can_submit" class="d-flex justify-content-end mb-3">
                <a href="/my/trucalc/bank/orders/new" class="btn btn-primary">New Request</a>
            </div>
            <div t-if="not orders" class="alert alert-info" role="status">
                You currently have no authorized TruCalc requests.
            </div>
            <t t-if="orders" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Order Number</th>
                        <th>Borrower</th>
                        <th>Property Address</th>
                        <th>Service Type</th>
                        <th>Client Due Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="orders" t-as="order">
                        <td>
                            <a t-att-href="'/my/trucalc/bank/orders/%s/documents' % order.order_number">
                                <t t-out="order.order_number"/>
                            </a>
                            <span t-if="order.status == 'draft'" class="badge text-bg-secondary ms-1">Resume Draft</span>
                        </td>
                        <td><t t-out="order.borrower"/></td>
                        <td><t t-out="order.property_address"/></td>
                        <td><span t-field="order.service_type"/></td>
                        <td><span t-if="order.due_date" t-field="order.due_date"/></td>
                        <td><span t-field="order.status"/></td>
                    </tr>
                </tbody>
            </t>
            <div t-if="pager" class="d-flex justify-content-center mt-3">
                <t t-call="portal.pager"/>
            </div>
            </div>
        </t>
    </template>

    <template id="portal_bank_order_new" name="New Bank TruCalc Request">
        <t t-call="portal.portal_layout">
            <div class="o_trucalc_bank_portal">
            <h2>Create TruCalc Draft</h2>
            <div t-if="submission_error" class="alert alert-danger" role="alert">
                <t t-out="submission_error"/>
            </div>
            <div t-if="not service_areas" class="alert alert-info" role="status">
                No active Service Areas are currently available. You may save a Draft,
                but an active State, County, and Service Type will be required before Send.
            </div>
            <t t-call="trucalc_orders.portal_bank_draft_form"/>
            </div>
        </t>
    </template>

    <template id="portal_bank_draft_form" name="Bank TruCalc Draft Form">
            <form t-att-action="order and ('/my/trucalc/bank/orders/%s/draft/save' % order.order_number) or '/my/trucalc/bank/orders/new'"
                  method="post" class="card card-body o_trucalc_bank_draft_form"
                  t-att-id="order and 'o_trucalc_bank_draft_form' or False"
                  t-att-data-service-areas="service_area_matrix"
                  t-att-data-selected-state="form_values.get('service_state_id', '')"
                  t-att-data-selected-county="form_values.get('service_county', '')"
                  t-att-data-selected-service="form_values.get('service_type', '')"
                  t-att-data-selected-area="form_values.get('service_area_id', '')">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="service_area_id" t-att-value="form_values.get('service_area_id', '')"/>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">Borrower</label><input name="borrower" class="form-control" required="required" maxlength="255" t-att-value="form_values.get('borrower', '')"/></div>
                    <div class="col-md-6"><label class="form-label">Loan Number</label><input name="loan_number" class="form-control" maxlength="255" t-att-value="form_values.get('loan_number', '')"/></div>
                    <div class="col-12"><label class="form-label">Property Address</label><input name="property_address" class="form-control" required="required" maxlength="512" t-att-value="form_values.get('property_address', '')"/></div>
                    <div class="col-md-6"><label class="form-label">City</label><input name="city" class="form-control" maxlength="255" t-att-value="form_values.get('city', '')"/></div>
                    <div class="col-md-6"><label class="form-label">ZIP</label><input name="zip_code" class="form-control" maxlength="20" t-att-value="form_values.get('zip_code', '')"/></div>
                    <div class="col-md-4"><label class="form-label">State</label><select name="service_state_id" class="form-select"><option value="">Select a State</option></select></div>
                    <div class="col-md-4"><label class="form-label">County</label><select name="service_county" class="form-select" disabled="disabled"><option value="">Select a County</option></select></div>
                    <div class="col-md-4"><label class="form-label">Service Type</label><select name="service_type" class="form-select" disabled="disabled"><option value="">Select a Service</option></select></div>
                    <div class="col-md-4">
                        <label class="form-label">Service Fee</label>
                        <div class="form-control-plaintext" data-service-fee="">Not configured</div>
                        <div class="form-text">Informational until the request is sent.</div>
                    </div>
                    <div class="col-md-6"><label class="form-label">Property Type</label><select name="property_type" class="form-select"><option value="">Select a Property Type</option><option t-foreach="property_types" t-as="item" t-att-value="item[0]" t-att-selected="form_values.get('property_type') == item[0]"><t t-out="item[1]"/></option></select></div>
                    <div class="col-md-6"><label class="form-label">Client Due Date</label><input type="date" name="due_date" class="form-control" t-att-min="today" t-att-value="form_values.get('due_date', '')"/></div>
                    <div class="col-md-4"><label class="form-label">Inspection Contact Person</label><input name="inspection_contact_name" class="form-control" maxlength="255" t-att-value="form_values.get('inspection_contact_name', '')"/></div>
                    <div class="col-md-4"><label class="form-label">Inspection Contact Phone</label><input name="inspection_contact_phone" class="form-control" maxlength="64" t-att-value="form_values.get('inspection_contact_phone', '')"/></div>
                    <div class="col-md-4"><label class="form-label">Inspection Contact Email</label><input type="email" name="inspection_contact_email" class="form-control" maxlength="254" t-att-value="form_values.get('inspection_contact_email', '')"/></div>
                    <div class="col-12"><label class="form-label">Notes / Instructions</label><textarea name="notes" class="form-control" rows="4" maxlength="5000"><t t-out="form_values.get('notes', '')"/></textarea></div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button t-if="not order" type="submit" class="btn btn-primary">Create Draft</button>
                    <button t-if="order" type="submit" name="draft_action" value="save"
                            class="btn btn-secondary">Save Draft</button>
                    <button t-if="order" type="submit" class="btn btn-primary"
                            name="draft_action" value="send"
                            t-att-formaction="'/my/trucalc/bank/orders/%s/draft/send' % order.order_number">Send Request</button>
                    <a href="/my/trucalc/bank/orders" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
    </template>

    <template id="portal_bank_documents" name="Bank TruCalc Documents">
        <t t-call="portal.portal_layout">
            <div class="o_trucalc_bank_portal">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2><t t-if="order.status == 'draft'">TruCalc Draft</t><t t-else="">TruCalc Request</t> <t t-out="order.order_number"/></h2>
                <a href="/my/trucalc/bank/orders" class="btn btn-outline-secondary">Back to My TruCalc Requests</a>
            </div>
            <div t-if="submitted" class="alert alert-success" role="status">
                Your TruCalc request was submitted successfully.
            </div>
            <div t-if="created" class="alert alert-success" role="status">
                Draft created. Complete the request, add documents, and send it when ready.
            </div>
            <div t-if="saved" class="alert alert-success" role="status">Draft saved.</div>
            <div t-if="submission_error" class="alert alert-danger" role="alert"><t t-out="submission_error"/></div>
            <t t-if="order.status == 'draft'" t-call="trucalc_orders.portal_bank_draft_form"/>
            <div t-if="order.status != 'draft'" class="card mb-3">
                <div class="card-header"><strong>Request Details</strong></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Order Number</dt>
                        <dd class="col-sm-8"><t t-out="order.order_number"/></dd>
                        <dt class="col-sm-4">Borrower</dt>
                        <dd class="col-sm-8"><t t-out="order.borrower"/></dd>
                        <dt class="col-sm-4">Property Address</dt>
                        <dd class="col-sm-8"><t t-out="order.property_address"/></dd>
                        <dt class="col-sm-4">County</dt>
                        <dd class="col-sm-8"><t t-out="order.county"/></dd>
                        <dt class="col-sm-4">Loan Number</dt>
                        <dd class="col-sm-8"><t t-out="order.loan_number"/></dd>
                        <dt class="col-sm-4">Service Type</dt>
                        <dd class="col-sm-8"><span t-field="order.service_type"/></dd>
                        <dt t-if="order.fee_locked_at" class="col-sm-4">Agreed Fee</dt>
                        <dd t-if="order.fee_locked_at" class="col-sm-8">
                            <span t-field="order.agreed_fee"
                                  t-options="{'widget': 'monetary', 'display_currency': order.fee_currency_id}"/>
                        </dd>
                        <dt class="col-sm-4">Client Due Date</dt>
                        <dd class="col-sm-8"><span t-if="order.due_date" t-field="order.due_date"/></dd>
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8"><span t-field="order.status"/></dd>
                        <dt class="col-sm-4">Inspection Contact Person</dt>
                        <dd class="col-sm-8"><t t-out="order.inspection_contact_name"/></dd>
                        <dt class="col-sm-4">Inspection Contact Phone</dt>
                        <dd class="col-sm-8"><t t-out="order.inspection_contact_phone_display"/></dd>
                        <dt class="col-sm-4">Inspection Contact Email</dt>
                        <dd class="col-sm-8"><t t-out="order.inspection_contact_email"/></dd>
                    </dl>
                </div>
            </div>
            <div t-if="upload_error" class="alert alert-danger"><t t-out="upload_error"/></div>
            <div t-if="approved_valuation" class="card mb-3">
                <div class="card-header"><strong>Approved Valuation</strong></div>
                <div class="card-body">
                    <div><strong>Filename:</strong> <t t-out="approved_valuation.filename"/></div>
                    <div><strong>Submitted:</strong> <span t-field="approved_valuation.submitted_at"/></div>
                    <div><strong>Approved:</strong> <span t-field="valuation_approval.event_at"/></div>
                    <a class="btn btn-sm btn-outline-primary mt-2"
                       t-att-href="'/my/trucalc/bank/orders/%s/valuation/%s/download' % (order.order_number, approved_valuation.id)">
                        Download Approved Valuation
                    </a>
                </div>
            </div>
            <h3>Documents</h3>
            <form t-if="can_upload and order.status not in ('draft', 'completed')"
                  t-att-action="'/my/trucalc/bank/orders/%s/documents/upload' % order.order_number"
                  method="post" enctype="multipart/form-data" class="card card-body mb-3">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="draft_action" value="upload"/>
                <div class="mb-3">
                    <label class="form-label">Document Tag</label>
                    <select name="tag_id" class="form-select" required="required">
                        <option value="">Select a Tag</option>
                        <option t-foreach="tags" t-as="tag" t-att-value="tag.id"><t t-out="tag.name"/></option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">File</label>
                    <input type="file" name="document_file" class="form-control" required="required"/>
                </div>
                <button type="submit" class="btn btn-primary">Upload Document</button>
            </form>
            <form t-if="can_upload and order.status == 'draft'"
                  t-att-action="'/my/trucalc/bank/orders/%s/documents/upload' % order.order_number"
                  method="post" enctype="multipart/form-data"
                  class="card card-body mb-3 o_trucalc_bank_draft_upload_form"
                  data-draft-form-id="o_trucalc_bank_draft_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="draft_action" value="upload"/>
                <div class="mb-3">
                    <label class="form-label">Document Tag</label>
                    <select name="tag_id" class="form-select" required="required">
                        <option value="">Select a Tag</option>
                        <option t-foreach="tags" t-as="tag" t-att-value="tag.id"><t t-out="tag.name"/></option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">File</label>
                    <input type="file" name="document_file" class="form-control"
                           required="required"/>
                </div>
                <button type="submit" class="btn btn-primary">
                    Save Draft &amp; Upload Document
                </button>
            </form>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead><tr><th>File Name</th><th>Tag</th><th>Uploaded By</th><th>Uploaded Date</th><th>Actions</th></tr></thead>
                    <tbody>
                        <tr t-foreach="documents" t-as="document">
                            <td><t t-out="document.filename"/></td>
                            <td><t t-out="document.tag_id.name"/></td>
                            <td><t t-out="document.uploaded_by.name"/></td>
                            <td><span t-field="document.upload_date"/></td>
                            <td class="d-flex gap-2">
                                <a class="btn btn-sm btn-outline-primary"
                                   t-att-href="'/my/trucalc/bank/orders/%s/documents/%s/download' % (order.order_number, document.id)">Download</a>
                                <form t-if="can_delete_draft_documents"
                                      t-att-action="'/my/trucalc/bank/orders/%s/documents/%s/delete' % (order.order_number, document.id)"
                                      method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                        <tr t-if="not documents"><td colspan="5" class="text-muted">No supporting documents.</td></tr>
                    </tbody>
                </table>
            </div>
            </div>
        </t>
    </template>
</odoo>
