<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_trucalc_orders"
              name="My TruCalc Orders"
              inherit_id="portal.portal_my_home"
              priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_vendor_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_vendor_category" position="inside">
            <t t-if="request.env.user.has_group('trucalc_orders.group_vendor_portal')"
               t-call="portal.portal_docs_entry">
                <t t-set="title">My TruCalc Orders</t>
                <t t-set="text">View your authorized TruCalc orders</t>
                <t t-set="url" t-value="'/my/trucalc/orders'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

    <template id="portal_trucalc_order_breadcrumbs"
              name="TruCalc Order Breadcrumbs"
              inherit_id="portal.portal_breadcrumbs"
              priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name in ('trucalc_orders', 'trucalc_order')"
                t-attf-class="breadcrumb-item #{'active' if page_name == 'trucalc_orders' else ''}">
                <a t-if="page_name == 'trucalc_order'" href="/my/trucalc/orders">
                    My TruCalc Orders
                </a>
                <t t-else="">My TruCalc Orders</t>
            </li>
            <li t-if="page_name == 'trucalc_order'" class="breadcrumb-item active">
                <t t-out="projection.order_number"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_trucalc_orders" name="My TruCalc Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My TruCalc Orders</t>
            </t>

            <div t-if="not projections" class="alert alert-info" role="status">
                You currently have no authorized TruCalc orders.
            </div>

            <t t-if="projections" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Service</th>
                        <th>Borrower</th>
                        <th>Property</th>
                        <th>Status</th>
                        <th>Your Response</th>
                        <th>Due</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="projections" t-as="projection">
                        <td>
                            <a t-att-href="'/my/trucalc/orders/%s' % projection.order_number">
                                <t t-out="projection.order_number"/>
                            </a>
                        </td>
                        <td><span t-field="projection.service_type"/></td>
                        <td><span t-field="projection.borrower"/></td>
                        <td>
                            <div t-out="projection.property_address"/>
                            <small class="text-muted">
                                <t t-out="projection.city"/>,
                                <t t-out="projection.state"/>
                                <t t-out="projection.zip_code"/>
                            </small>
                        </td>
                        <td><span t-field="projection.order_status"/></td>
                        <td><t t-out="projection.vendor_response_label or '—'"/></td>
                        <td>
                            <span t-if="projection.due_date" t-field="projection.due_date"/>
                            <span t-elif="projection.response_deadline"
                                  t-field="projection.response_deadline"/>
                            <span t-else="">—</span>
                        </td>
                    </tr>
                </tbody>
            </t>

            <div t-if="pager" class="d-flex justify-content-center mt-3">
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <template id="portal_my_trucalc_order" name="TruCalc Order">
        <t t-call="portal.portal_layout">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">
                    TruCalc Order <t t-out="projection.order_number"/>
                </h2>
                <a href="/my/trucalc/orders" class="btn btn-outline-secondary">
                    Back to My TruCalc Orders
                </a>
            </div>

            <div class="card">
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Service</dt>
                        <dd class="col-sm-8"><span t-field="projection.service_type"/></dd>

                        <dt class="col-sm-4">Borrower</dt>
                        <dd class="col-sm-8"><span t-field="projection.borrower"/></dd>

                        <dt class="col-sm-4">Property type</dt>
                        <dd class="col-sm-8"><span t-field="projection.property_type"/></dd>

                        <dt class="col-sm-4">Property address</dt>
                        <dd class="col-sm-8">
                            <div t-out="projection.property_address"/>
                            <div>
                                <t t-out="projection.city"/>,
                                <t t-out="projection.state"/>
                                <t t-out="projection.zip_code"/>
                            </div>
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8"><span t-field="projection.order_status"/></dd>

                        <dt t-if="projection.response_deadline" class="col-sm-4">
                            Response deadline
                        </dt>
                        <dd t-if="projection.response_deadline" class="col-sm-8">
                            <span t-field="projection.response_deadline"/>
                        </dd>

                        <dt t-if="projection.vendor_phase == 'invitation'" class="col-sm-4">
                            Standard fee
                        </dt>
                        <dd t-if="projection.vendor_phase == 'invitation'" class="col-sm-8">
                            <span t-if="projection.solicitation_standard_fee is not False"
                                  t-field="projection.solicitation_standard_fee"
                                  t-options="{'widget': 'monetary', 'display_currency': projection.currency_id}"/>
                            <span t-else="">Not recorded for this legacy invitation</span>
                        </dd>

                        <dt t-if="projection.due_date" class="col-sm-4">Due date</dt>
                        <dd t-if="projection.due_date" class="col-sm-8">
                            <span t-field="projection.due_date"/>
                        </dd>

                        <dt t-if="projection.vendor_phase in ('invitation', 'declined_history')"
                            class="col-sm-4">Requested delivery date</dt>
                        <dd t-if="projection.vendor_phase in ('invitation', 'declined_history')"
                            class="col-sm-8">
                            <span t-if="projection.requested_delivery_date"
                                  t-field="projection.requested_delivery_date"/>
                            <span t-else="">Not recorded for this historical invitation</span>
                        </dd>

                        <dt t-if="projection.is_assigned" class="col-sm-4">Agreed fee</dt>
                        <dd t-if="projection.is_assigned" class="col-sm-8">
                            <span t-field="projection.agreed_vendor_fee"
                                  t-options="{'widget': 'monetary', 'display_currency': projection.currency_id}"/>
                        </dd>
                    </dl>
                </div>
            </div>

            <div t-if="response_error" class="alert alert-danger mt-3" role="alert">
                <t t-out="response_error"/>
            </div>

            <div t-if="projection.vendor_phase in ('invitation', 'declined_history') or projection.response_type"
                 class="card mt-3">
                <div class="card-header"><strong>Vendor Response</strong></div>
                <div class="card-body">
                    <t t-if="projection.vendor_status == 'declined'">
                        <p class="mb-1"><strong>Response Status:</strong> Declined</p>
                        <p t-if="projection.vendor_decline_reason" class="mb-0">
                            <strong>Reason:</strong>
                            <t t-out="projection.vendor_decline_reason"/>
                        </p>
                    </t>
                    <t t-elif="projection.response_type">
                        <dl class="row">
                            <dt class="col-sm-4">Response</dt>
                            <dd class="col-sm-8"><span t-field="projection.response_type"/></dd>
                            <dt class="col-sm-4">Proposed fee</dt>
                            <dd class="col-sm-8">
                                <span t-field="projection.proposed_fee"
                                      t-options="{'widget': 'monetary', 'display_currency': projection.currency_id}"/>
                            </dd>
                            <dt class="col-sm-4">Proposed delivery date</dt>
                            <dd class="col-sm-8"><span t-field="projection.proposed_delivery_date"/></dd>
                            <dt t-if="projection.vendor_comments" class="col-sm-4">Comments</dt>
                            <dd t-if="projection.vendor_comments" class="col-sm-8">
                                <t t-out="projection.vendor_comments"/>
                            </dd>
                            <dt class="col-sm-4">Status</dt>
                            <dd class="col-sm-8"><span t-field="projection.response_status"/></dd>
                        </dl>
                    </t>

                    <div t-if="projection.can_respond">
                        <h5 t-if="projection.response_type">Revise Response</h5>

                        <form t-att-action="'/my/trucalc/orders/%s/response' % projection.order_number"
                              method="post" class="border rounded p-3 mb-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="response_type"
                                   value="standard_terms_accepted"/>
                            <h6>Accept Standard Terms</h6>
                            <p>Accept the displayed Standard Fee and Requested Delivery Date.</p>
                            <button type="submit" class="btn btn-primary">Accept Standard Terms</button>
                        </form>

                        <form t-att-action="'/my/trucalc/orders/%s/response' % projection.order_number"
                              method="post" class="border rounded p-3 mb-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="response_type" value="delivery_date_counter"/>
                            <h6>Accept Fee / Change Delivery Date</h6>
                            <div class="mb-2">
                                <label class="form-label">Proposed Delivery Date</label>
                                <input type="date" name="proposed_delivery_date"
                                       class="form-control" required="required"/>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Vendor Comments</label>
                                <textarea name="comments" class="form-control" rows="2"/>
                            </div>
                            <button type="submit" class="btn btn-primary">Submit Date Change</button>
                        </form>

                        <form t-att-action="'/my/trucalc/orders/%s/response' % projection.order_number"
                              method="post" class="border rounded p-3 mb-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="response_type" value="fee_and_delivery_counter"/>
                            <h6>Counter Fee and Delivery Date</h6>
                            <div class="mb-2">
                                <label class="form-label">Proposed Fee</label>
                                <input type="number" name="proposed_fee" min="0" step="0.01"
                                       class="form-control" required="required"/>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Proposed Delivery Date</label>
                                <input type="date" name="proposed_delivery_date"
                                       class="form-control" required="required"/>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Vendor Comments</label>
                                <textarea name="comments" class="form-control" rows="2"/>
                            </div>
                            <button type="submit" class="btn btn-primary">Submit Counteroffer</button>
                        </form>

                        <form t-if="not projection.response_type"
                              t-att-action="'/my/trucalc/orders/%s/decline' % projection.order_number"
                              method="post" class="border border-danger rounded p-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <h6>Decline Bid Request</h6>
                            <div class="mb-2">
                                <label class="form-label">Decline Reason</label>
                                <textarea name="decline_reason" class="form-control" rows="2"
                                          required="required"/>
                            </div>
                            <button type="submit" class="btn btn-outline-danger">Decline Bid Request</button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
