<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->

    <record id="view_trucalc_order_list" model="ir.ui.view">
        <field name="name">trucalc.order.list</field>
        <field name="model">trucalc.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_number"/>
                <field name="borrower"/>
                <field name="loan_number"/>
                <field name="property_address"/>
                <field name="company_id"/>
                <field name="status"/>
                <field name="engagement_action_required" column_invisible="True"
                       groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"/>
                <field name="engagement_action_required_label" widget="badge"
                       decoration-danger="engagement_action_required"
                       groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"/>
                <field name="engagement_action_required_reason"
                       groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"/>
                <field name="assigned_vendor_id"/>
                <field name="due_date" options="{'numeric': True}"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->

    <record id="view_trucalc_order_form" model="ir.ui.view">
        <field name="name">trucalc.order.form</field>
        <field name="model">trucalc.order</field>
        <field name="arch" type="xml">

            <form string="Evaluation Order">

                <header>
                    <field name="can_request_fee_change" invisible="1"/>
                    <button name="action_open_fee_change_wizard" type="object" string="Request Fee Change"
                            groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                            invisible="not can_request_fee_change"/>


                    <field name="is_internal_draft" invisible="1"/>

                    <button
                        string="Save Draft"
                        special="save"
                        class="btn-secondary"
                        groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                        invisible="not is_internal_draft"/>

                    <button
                        name="action_submit_internal_draft"
                        string="Submit"
                        type="object"
                        class="btn-primary"
                        groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                        invisible="not id or not is_internal_draft"
                        confirm="Submit this Draft as a New request and lock its current pricing?"/>

                    <button
                        name="action_accept_request"
                        string="Accept"
                        type="object"
                        class="btn-primary"
                        groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                        invisible="not id or status != 'new'"/>

                    <button
                        name="action_open_decline_wizard"
                        string="Decline"
                        type="object"
                        class="btn-secondary"
                        groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                        invisible="not id or status != 'new'"/>

                    <button
                        name="action_open_request_bids_wizard"
                        string="Request Bids"
                        type="object"
                        class="btn-primary"
                        groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                        invisible="not can_request_vendor_bids"/>

                    <button
                        name="action_open_manage_bid_requests_wizard"
                        string="Manage Bid Requests"
                        type="object"
                        class="btn-secondary"
                        groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                        invisible="status != 'bid_requested' or not current_round_has_solicitation"/>

                    <button
                        name="action_open_extend_bid_deadline_wizard"
                        string="Extend Bid Deadline"
                        type="object"
                        class="btn-secondary"
                        groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                        invisible="status != 'bid_requested' or not current_round_has_solicitation"/>

                    <button
                        name="action_reopen_bidding"
                        string="Reopen Bidding"
                        type="object"
                        class="btn-secondary"
                        groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                        invisible="status not in ('assigned', 'engaged')"/>

                    <button
                        name="action_open_engagement_decision_wizard"
                        string="Review Delivery Change"
                        type="object"
                        class="btn-primary"
                        groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                        invisible="engagement_response_state != 'delivery_change_requested'"/>

                    <button
                        name="action_open_reviewer_assignment_wizard"
                        string="Assign Reviewer"
                        type="object"
                        class="btn-primary"
                        groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                        invisible="status != 'report_received'"/>

                    <button name="action_open_reviewer_assignment_wizard"
                            string="Reassign Reviewer" type="object" class="btn-secondary"
                            groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                            invisible="status not in ('reviewer_assigned', 'under_review') or valuation_approved"/>

                    <button name="action_start_review" string="Accept Review" type="object"
                            class="btn-primary" groups="trucalc_orders.group_trucalc_reviewer"
                            invisible="status != 'reviewer_assigned' or reviewer_user_id != uid"/>

                    <button name="action_open_valuation_revision_wizard"
                            string="Request Revision" type="object" class="btn-outline-primary"
                            groups="trucalc_orders.group_trucalc_reviewer"
                            invisible="status != 'under_review' or reviewer_user_id != uid or not current_valuation_id or valuation_approved or valuation_revision_requested"/>

                    <button name="action_approve_valuation" string="Approve Valuation"
                            type="object" class="btn-primary"
                            groups="trucalc_orders.group_trucalc_reviewer"
                            invisible="status != 'under_review' or reviewer_user_id != uid or not current_valuation_id or valuation_approved or valuation_revision_requested"/>

                    <button name="action_complete_order" string="Complete Order"
                            type="object" class="btn-primary"
                            groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                            invisible="status != 'under_review' or not current_valuation_id or not valuation_approved or valuation_revision_requested or not vendor_invoice_id"
                            confirm="Complete this Order? Completion releases the approved Valuation to the Bank and closes the Order to further operational editing."/>

                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="new,accepted,bid_requested,engaged,report_received,reviewer_assigned,under_review,completed"
                        readonly="1"/>
                    <field name="current_round_has_solicitation" invisible="1"/>
                    <field name="can_request_vendor_bids" invisible="1"/>

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="order_number" readonly="1"/>
                        </h1>
                    </div>

                    <div class="alert alert-danger d-flex align-items-center gap-2"
                         role="alert"
                         groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                         invisible="not engagement_action_required">
                        <span class="badge text-bg-danger">Action Required</span>
                        <strong><field name="engagement_action_required_reason"/></strong>
                    </div>

                    <!-- Technical selector state stays on the form so onchange values are
                         persisted, but users work only with the three controlled widgets below. -->
                    <field name="available_pricing_state_ids" invisible="1"/>
                    <field name="available_pricing_county_area_ids" invisible="1"/>
                    <field name="available_pricing_service_area_ids" invisible="1"/>
                    <field name="available_internal_bank_ids" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="county" invisible="1"/>
                    <field name="service_type" invisible="1"/>
                    <field name="create_date" invisible="1"/>

                    <group>
                        <group string="Order / Request Information">
                            <field name="company_id" string="Bank"
                                   domain="[('id', 'in', available_internal_bank_ids)]"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   readonly="fee_locked_at or (create_date and not is_internal_draft)"/>
                            <field name="requestor_id" string="Requester" readonly="1"/>
                            <field name="order_date_display" string="Order Date"/>
                            <field name="loan_number" string="Loan Number"
                                   readonly="status == 'completed'"/>
                            <field name="borrower" string="Borrower"
                                   required="not is_internal_draft"
                                   readonly="status == 'completed'"/>
                            <field name="due_date" string="Due Date"
                                   required="not is_internal_draft"
                                   options="{'numeric': True}" readonly="status == 'completed'"/>
                            <field name="status" string="Status" readonly="1"/>
                        </group>

                        <group string="Property / Service Details">
                            <field name="property_address" required="not is_internal_draft"
                                   readonly="status == 'completed'"/>
                            <field name="city" readonly="status == 'completed'"/>
                            <field name="pricing_state_id" string="State"
                                   groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                                   context="{'trucalc_state_code_only': True}"
                                   required="0"
                                   domain="[('id', 'in', available_pricing_state_ids)]"
                                   readonly="fee_locked_at or status in ('declined', 'cancelled', 'completed') or (status == 'draft' and not is_internal_draft)"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="pricing_county_area_id" string="County"
                                   groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                                   context="{'trucalc_service_area_display': 'county'}"
                                   required="0"
                                   domain="[('id', 'in', available_pricing_county_area_ids)]"
                                   readonly="fee_locked_at or not pricing_state_id or status in ('declined', 'cancelled', 'completed') or (status == 'draft' and not is_internal_draft)"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="zip_code" readonly="status == 'completed'"/>
                            <field name="service_area_id" string="Service Type"
                                   groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                                   context="{'trucalc_service_area_display': 'service_type'}"
                                   required="0"
                                   domain="[('id', 'in', available_pricing_service_area_ids)]"
                                   readonly="fee_locked_at or not pricing_county_area_id or status in ('declined', 'cancelled', 'completed') or (status == 'draft' and not is_internal_draft)"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="property_type" readonly="status == 'completed'"/>
                        </group>
                    </group>

                    <group string="Inspection Contact">
                        <field name="inspection_contact_name" string="Name"
                               readonly="status == 'completed'"/>
                        <field name="inspection_contact_phone_display" string="Phone"
                               widget="inspection_phone_blur" readonly="status == 'completed'"/>
                        <field name="inspection_contact_email" string="Email"
                               widget="email" readonly="status == 'completed'"/>
                    </group>

                    <group string="Pricing Summary"
                           groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                           invisible="not fee_locked_at">
                        <field name="fee_currency_id" invisible="1"/>
                        <field name="agreed_fee" string="Original Agreed Fee" readonly="1" widget="monetary"
                               options="{'currency_field': 'fee_currency_id'}"/>
                        <field name="current_agreed_fee" readonly="1"/>
                        <field name="fee_change_pending" string="Fee Request Pending" readonly="1"/>
                        <field name="fee_change_request_ids" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="requested_at"/><field name="currency_id" column_invisible="True"/>
                                <field name="prior_fee"/><field name="proposed_fee"/>
                                <field name="state"/><field name="reason"/>
                                <field name="decision_at"/><field name="decline_reason"/>
                            </list>
                        </field>
                        <field name="fee_source" readonly="1"/>
                        <field name="negotiated_fee_id" readonly="1"
                               invisible="fee_source != 'negotiated'"/>
                        <field name="fee_locked_at" readonly="1"/>
                    </group>

                    <group string="Bank Invoice" invisible="not bank_invoice_ids"
                           groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations">

                        <field name="bank_invoice_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="invoice_number"/><field name="invoice_date"/><field name="due_date"/>
                                <field name="currency_id" column_invisible="True"/><field name="amount"/><field name="status"/>
                                <button name="action_download" type="object" string="Download Invoice"/>
                            </list>
                        </field>
                    </group>

                    <group string="Workflow Information">
                        <field name="assigned_vendor_id" readonly="(status in ('new', 'accepted', 'declined')) or status == 'completed'"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="vendor_fee" readonly="1" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="vendor_delivery_date" readonly="1"
                               options="{'numeric': True}"/>
                        <field name="vendor_engaged_at" readonly="1"/>
                        <field name="current_engagement_id" invisible="1"/>
                        <field name="engagement_action_required" invisible="1"
                               groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"/>
                        <field name="engagement_response_state" readonly="1"
                               groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"/>
                        <field name="engagement_requested_delivery_date" readonly="1"
                               options="{'numeric': True}"
                               groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                               invisible="engagement_response_state != 'delivery_change_requested'"/>
                        <field name="engagement_request_reason" readonly="1"
                               groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                               invisible="engagement_response_state != 'delivery_change_requested'"/>
                        <field name="engagement_decline_reason" readonly="1"
                               groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                               invisible="engagement_response_state != 'declined'"/>
                        <field name="fee_override" readonly="(status in ('new', 'accepted', 'declined')) or status == 'completed'"/>
                        <field name="reviewer_user_id"
                               groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations,trucalc_orders.group_trucalc_reviewer"
                               readonly="1"/>
                        <field name="decline_reason" invisible="status != 'declined'" readonly="1"/>
                    </group>

                    <div name="deliverables_display" class="mb-3">
                        <field name="current_valuation_id" invisible="1"
                               groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations,trucalc_orders.group_trucalc_reviewer"/>
                        <field name="previous_valuation_count" invisible="1"
                               groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations,trucalc_orders.group_trucalc_reviewer"/>
                        <field name="valuation_approved" invisible="1"
                               groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations,trucalc_orders.group_trucalc_reviewer"/>
                        <div name="valuation_display" class="mb-3"
                             groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations,trucalc_orders.group_trucalc_reviewer">
                            <div class="mb-1">
                                <strong class="me-1">Valuation:</strong>
                                <field name="valuation_filename_link" widget="html" nolabel="1" class="oe_inline"/>
                                <button name="action_view_previous_valuations" type="object"
                                        string="View Previous Versions" class="btn-link p-0 ms-3"
                                        invisible="previous_valuation_count == 0"/>
                            </div>
                            <div invisible="not current_valuation_id" class="d-flex align-items-center gap-4">
                                <div class="d-flex align-items-center">
                                    <span class="text-muted me-1">Submitted Date:</span>
                                    <field name="valuation_submitted_at" nolabel="1" class="oe_inline"
                                           options="{'show_time': False, 'numeric': True}"/>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="text-muted me-1">Status:</span>
                                    <field name="valuation_deliverable_status" nolabel="1" class="oe_inline"/>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="text-muted me-1">Version:</span>
                                    <field name="valuation_version" nolabel="1" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="alert alert-warning mt-2" role="status"
                                 invisible="not valuation_revision_requested">
                                <strong>Revision Requested</strong>
                                <div><field name="valuation_revision_instructions" nolabel="1" readonly="1"/></div>
                            </div>
                            <div class="alert alert-success mt-2" role="status"
                                 invisible="not valuation_approved">
                                <strong>Valuation Approved</strong>
                                <span class="ms-2"><field name="valuation_approved_at" nolabel="1" readonly="1"/></span>
                            </div>
                        </div>

                        <field name="vendor_invoice_id" invisible="1"
                               groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"/>
                        <div name="vendor_invoice_display"
                             groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations">
                            <div class="mb-1">
                                <strong class="me-1">Vendor Invoice:</strong>
                                <field name="vendor_invoice_filename_link" widget="html" nolabel="1" class="oe_inline"/>
                            </div>
                            <div invisible="not vendor_invoice_id" class="d-flex align-items-center gap-4">
                                <div class="d-flex align-items-center">
                                    <span class="text-muted me-1">Submitted Date:</span>
                                    <field name="vendor_invoice_submitted_at" nolabel="1" class="oe_inline"
                                           options="{'show_time': False, 'numeric': True}"/>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="text-muted me-1">Status:</span>
                                    <field name="vendor_invoice_deliverable_status" nolabel="1" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <notebook>

                        <page string="Notes">

                            <field name="notes" readonly="status == 'completed'"/>

                        </page>

                        <page string="Documents">

                            <button name="action_add_document" type="object"
                                    string="Add Document" icon="fa-plus"
                                    class="btn-primary mb-2"
                                    groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                                    invisible="(not id) or status == 'completed'"/>

                            <field name="document_ids" readonly="status == 'completed'">

                                <list create="false" delete="false" editable="bottom"
                                      open_form_view="false" limit="10000">
                                    <field name="active" column_invisible="True" readonly="parent.status == 'completed'"/>
                                    <field name="filename" string="Document Name" readonly="1"/>
                                    <field name="tag_id" widget="many2one_autosave"
                                           domain="[('active', '=', True)]"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" readonly="parent.status == 'completed'"/>
                                    <field name="visible_before_engagement" widget="boolean_toggle"
                                           options="{'autosave': True}" readonly="parent.status == 'completed'"/>
                                    <field name="visible_after_engagement" widget="boolean_toggle"
                                           options="{'autosave': True}" readonly="parent.status == 'completed'"/>
                                    <button name="action_download" type="object" icon="fa-download"
                                            title="Download" invisible="not active"/>
                                    <button name="action_controlled_delete" type="object" icon="fa-trash"
                                            title="Delete" invisible="not active or parent.status == 'completed'"
                                            groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                                            confirm-title="Delete Document?" confirm-label="Delete"
                                            confirm="Are you sure you want to delete this document? This action cannot be undone."/>
                                </list>

                            </field>

                        </page>

                        <page string="Vendor Responses"
                              groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations">
                            <field name="bid_ids" readonly="1"
                                   class="o_trucalc_vendor_responses">
                                <list class="o_trucalc_vendor_responses"
                                      decoration-muted="round_number &lt; parent.bidding_round">
                                    <button name="action_select_bid" type="object"
                                            string="Select"
                                            groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"
                                            invisible="not is_currently_selectable"/>
                                    <button string="Selected"
                                            class="btn-success opacity-100"
                                            invisible="status != 'selected' or round_number &lt; parent.bidding_round"/>
                                    <button string="Selected"
                                            class="btn-secondary opacity-75"
                                            invisible="status != 'selected' or round_number &gt;= parent.bidding_round"/>
                                    <button string="Not Selected"
                                            class="btn-secondary opacity-100"
                                            invisible="status != 'not_selected' or round_number &lt; parent.bidding_round"/>
                                    <button string="Not Selected"
                                            class="btn-secondary opacity-75"
                                            invisible="status != 'not_selected' or round_number &gt;= parent.bidding_round"/>
                                    <button string="Disqualified"
                                            class="btn-danger opacity-100"
                                            invisible="status != 'disqualified' or round_number &lt; parent.bidding_round"/>
                                    <button string="Disqualified"
                                            class="btn-secondary opacity-75"
                                            invisible="status != 'disqualified' or round_number &gt;= parent.bidding_round"/>
                                    <field name="status" column_invisible="True"/>
                                    <field name="is_currently_selectable" column_invisible="True"/>
                                    <field name="round_number"/>
                                    <field name="vendor_id"/>
                                    <field name="response_type"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="solicited_standard_fee" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="bid_amount" string="Proposed Fee" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="requested_delivery_date"
                                           options="{'numeric': True}"/>
                                    <field name="proposed_delivery_date"
                                           options="{'numeric': True}"/>
                                    <field name="notes" string="Vendor Comments"/>
                                    <field name="submitted_at"/>
                                    <field name="last_revised_at"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                    <chatter/>

                </sheet>

            </form>

        </field>
    </record>

    <record id="view_trucalc_order_search" model="ir.ui.view">
        <field name="name">trucalc.order.search</field>
        <field name="model">trucalc.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_number"/>
                <field name="borrower"/>
                <field name="loan_number"/>
                <field name="status"/>
                <filter name="action_required" string="Action Required"
                        domain="[('engagement_action_required', '=', True)]"
                        groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->

    <record id="action_trucalc_orders" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">trucalc.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            Command.clear(),
            Command.create({'sequence': 1, 'view_mode': 'list', 'view_id': ref('view_trucalc_order_list')}),
            Command.create({'sequence': 2, 'view_mode': 'form', 'view_id': ref('view_trucalc_order_form')}),
        ]"/>
        <field name="domain">['|', ('status', '!=', 'draft'), ('requestor_id.share', '=', False)]</field>
        <field name="context">{'default_status': 'draft', 'default_company_id': False, 'trucalc_internal_draft_intake': True}</field>
    </record>

    <record id="view_trucalc_draft_support_list" model="ir.ui.view">
        <field name="name">trucalc.order.draft.support.list</field>
        <field name="model">trucalc.order</field>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="order_number"/>
                <field name="company_id"/>
                <field name="requestor_id"/>
                <field name="borrower"/>
                <field name="property_address"/>
                <field name="write_date" string="Last Updated"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_trucalc_draft_support_form" model="ir.ui.view">
        <field name="name">trucalc.order.draft.support.form</field>
        <field name="model">trucalc.order</field>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <form string="Bank Draft Technical Support" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="order_number" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="requestor_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="borrower" readonly="1"/>
                            <field name="property_address" readonly="1"/>
                            <field name="city" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="county" readonly="1"/>
                            <field name="zip_code" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trucalc_draft_support" model="ir.actions.act_window">
        <field name="name">Bank Draft Support</field>
        <field name="res_model">trucalc.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            Command.clear(),
            Command.create({'sequence': 1, 'view_mode': 'list', 'view_id': ref('view_trucalc_draft_support_list')}),
            Command.create({'sequence': 2, 'view_mode': 'form', 'view_id': ref('view_trucalc_draft_support_form')}),
        ]"/>
        <field name="domain">[('status', '=', 'draft'), ('requestor_id.share', '=', True)]</field>
    </record>

