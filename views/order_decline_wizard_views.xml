<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_order_decline_wizard_form" model="ir.ui.view">
        <field name="name">trucalc.order.decline.wizard.form</field>
        <field name="model">trucalc.order.decline.wizard</field>
        <field name="arch" type="xml">
            <form string="Decline Request">
                <group>
                    <field name="order_id"/>
                    <field name="reason" placeholder="Explain why TruCalc is declining this request..."/>
                </group>
                <footer>
                    <button name="action_decline" type="object" string="Decline Request" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
