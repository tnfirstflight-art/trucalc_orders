<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_order_decline_wizard_form" model="ir.ui.view">
        <field name="name">trucalc.order.decline.wizard.form</field>
        <field name="model">trucalc.order.decline.wizard</field>
        <field name="arch" type="xml">
            <form string="Decline Request">
                <group>
                    <field name="order_id"/>
                    <field name="reason" placeholder="Explain why TruCalc is declining this request..."/>
                </group>
                <footer>
                    <button name="action_decline" type="object" string="Decline Request" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_trucalc_order_post_acceptance_decline_wizard_form" model="ir.ui.view">
        <field name="name">trucalc.order.post.acceptance.decline.wizard.form</field>
        <field name="model">trucalc.order.post.acceptance.decline.wizard</field>
        <field name="arch" type="xml">
            <form string="Decline After Acceptance">
                <div class="alert alert-warning" role="alert">
                    This action closes the active Vendor engagement and revokes Vendor access.
                    Contact the Vendor manually before confirming and record that communication below.
                </div>
                <group>
                    <field name="order_id"/>
                    <field name="category"/>
                    <field name="reason" placeholder="Describe the inspection findings or other reason..."/>
                    <field name="vendor_notification_note"
                           placeholder="Example: Called Vendor Name at 2:15 PM; confirmed work should stop."/>
                </group>
                <footer>
                    <button name="action_decline" type="object"
                            string="Decline Order" class="btn-primary"
                            confirm="Decline this engaged Order and revoke all Vendor access?"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
