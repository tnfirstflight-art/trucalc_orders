<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_branding" inherit_id="web.login" name="TruCalc Login Branding">
        <xpath expr="//t[@t-call='web.login_layout']" position="inside">
            <t t-set="trucalc_login" t-value="True"/>
            <t t-set="disable_footer" t-value="True"/>
        </xpath>
    </template>

    <template id="login_branding_layout" inherit_id="web.login_layout" name="TruCalc Login Card">
        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
            <attribute name="t-attf-class" add="#{'o_trucalc_login' if trucalc_login else ''}" separator=" "/>
        </xpath>
    </template>

    <template id="bank_portal_layout" name="TruCalc Bank Shell">
        <t t-call="portal.portal_layout">
            <t t-set="trucalc_bank_shell" t-value="True"/>
            <t t-set="trucalc_bank_filters" t-value="[
                ('open', 'Open Orders'),
                ('recent_completed', 'Recently Completed'),
                ('outstanding_invoices', 'Outstanding Invoices'),
                ('all', 'All Orders'),
            ]"/>
            <!-- Same configured identity as Bank invoice issuer; never switch company. -->
            <t t-set="trucalc_company_name" t-value="request.env.ref('base.main_company').sudo().name"/>
            <t t-out="0"/>
        </t>
    </template>

    <template id="vendor_portal_layout" name="TruCalc Vendor Shell">
        <t t-call="portal.portal_layout">
            <t t-set="trucalc_vendor_shell" t-value="True"/>
            <!-- Same configured identity as Bank shell/invoice issuer; never switch company. -->
            <t t-set="trucalc_company_name" t-value="request.env.ref('base.main_company').sudo().name"/>
            <t t-out="0"/>
        </t>
    </template>

    <template id="bank_shell_branding" inherit_id="portal.frontend_layout" name="Scoped TruCalc Bank Branding">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="#{'o_trucalc_bank_shell' if trucalc_bank_shell else ''} #{'o_trucalc_vendor_shell' if trucalc_vendor_shell else ''}" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']/header" position="attributes">
            <attribute name="t-attf-class" add="#{'o_trucalc_bank_header' if trucalc_bank_shell else ''} #{'o_trucalc_vendor_header' if trucalc_vendor_shell else ''}" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']/header/nav" position="after">
            <nav t-if="trucalc_bank_shell" class="o_trucalc_bank_filters" aria-label="Bank Orders filters">
                <div class="container">
                    <a t-foreach="trucalc_bank_filters" t-as="item"
                       t-att-href="'/my/trucalc/bank/orders?filterby=%s' % item[0]"
                       t-att-data-filter-key="item[0]"
                       t-attf-class="btn btn-sm #{'btn-primary' if filterby == item[0] else 'btn-outline-primary'}"
                       t-att-aria-current="'page' if filterby == item[0] else None">
                        <t t-out="item[1]"/>
                    </a>
                </div>
            </nav>
        </xpath>
        <xpath expr="//span[hasclass('o_footer_copyright_name')]/span[@t-field='res_company.name']" position="replace">
            <t t-if="trucalc_bank_shell or trucalc_vendor_shell"><span t-out="trucalc_company_name" itemprop="name"/></t>
            <span t-else="" t-field="res_company.name" itemprop="name"/>
        </xpath>
        <xpath expr="//t[@t-call='web.brand_promotion']" position="attributes">
            <attribute name="t-if">not trucalc_bank_shell and not trucalc_vendor_shell</attribute>
        </xpath>
    </template>
</odoo>
