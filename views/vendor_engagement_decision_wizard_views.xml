<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_vendor_engagement_decision_wizard_form" model="ir.ui.view">
        <field name="name">trucalc.vendor.engagement.decision.wizard.form</field>
        <field name="model">trucalc.vendor.engagement.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Delivery Change">
                <group>
                    <field name="engagement_id" invisible="1"/>
                    <field name="order_number"/>
                    <field name="vendor_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="agreed_vendor_fee" widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                    <field name="current_delivery_date" options="{'numeric': True}"/>
                    <field name="requested_delivery_date" options="{'numeric': True}"/>
                    <field name="vendor_reason"/>
                    <field name="approval_comment"
                           placeholder="Optional comment recorded with approval"/>
                    <field name="rejection_reason"
                           placeholder="Required when rejecting the request"/>
                </group>
                <footer>
                    <button name="action_approve" type="object"
                            string="Approve Change" class="btn-primary"/>
                    <button name="action_reject" type="object"
                            string="Reject Change" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
