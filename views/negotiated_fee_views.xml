<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_negotiated_fee_form" model="ir.ui.view">
        <field name="name">trucalc.negotiated.fee.form</field>
        <field name="model">trucalc.negotiated.fee</field>
        <field name="arch" type="xml">
            <form string="Negotiated Fee" delete="false">
                <group>
                    <field name="bank_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="service_area_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="currency_id" readonly="1"/>
                    <field name="negotiated_fee" widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                    <field name="active"/>
                </group>
            </form>
        </field>
    </record>
    <record id="action_trucalc_negotiated_fee_new" model="ir.actions.act_window">
        <field name="name">New Negotiated Fee</field>
        <field name="res_model">trucalc.negotiated.fee</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_trucalc_negotiated_fee_form"/>
        <field name="target">new</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>
    <record id="view_trucalc_negotiated_fee_list" model="ir.ui.view">
        <field name="name">trucalc.negotiated.fee.list</field>
        <field name="model">trucalc.negotiated.fee</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" editable="bottom">
                <header>
                    <button name="%(action_trucalc_negotiated_fee_new)d"
                            type="action" string="New" class="btn-primary"
                            display="always"/>
                </header>
                <field name="bank_id" readonly="1"/>
                <field name="service_area_id" readonly="1"/>
                <field name="negotiated_fee" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" readonly="1"/>
                <field name="active" widget="boolean_toggle"
                       options="{'autosave': True}"/>
            </list>
        </field>
    </record>
    <record id="view_trucalc_negotiated_fee_search" model="ir.ui.view">
        <field name="name">trucalc.negotiated.fee.search</field>
        <field name="model">trucalc.negotiated.fee</field>
        <field name="arch" type="xml">
            <search>
                <field name="bank_id"/>
                <field name="service_area_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_bank" string="Group by Bank" context="{'group_by': 'bank_id'}"/>
                <filter name="group_area" string="Group by Service Area" context="{'group_by': 'service_area_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_trucalc_negotiated_fees" model="ir.actions.act_window">
        <field name="name">Negotiated Fee Schedule</field>
        <field name="res_model">trucalc.negotiated.fee</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_trucalc_negotiated_fee_list"/>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem id="menu_trucalc_negotiated_fees" name="Negotiated Fee Schedule"
              parent="menu_trucalc_configuration"
              action="action_trucalc_negotiated_fees" sequence="30"
              groups="trucalc_orders.group_trucalc_admin"/>
</odoo>
