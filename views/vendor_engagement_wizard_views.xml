<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_vendor_engagement_wizard_form" model="ir.ui.view">
        <field name="name">trucalc.vendor.engagement.wizard.form</field>
        <field name="model">trucalc.vendor.engagement.wizard</field>
        <field name="arch" type="xml">
            <form string="Engage Vendor">
                <group>
                    <div colspan="2">
                        You are about to select this Vendor for the assignment.
                        Are you ready to engage this Vendor?
                    </div>
                    <field name="bid_id" invisible="1"/>
                    <field name="order_number"/>
                    <field name="vendor_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="accepted_fee" string="Vendor Fee" widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                    <field name="vendor_delivery_date_display"/>
                </group>
                <footer>
                    <button name="action_engage_vendor" type="object"
                            string="Engage Vendor" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
