<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_odoo_access_level" model="ir.ui.view">
        <field name="name">res.users.form.odoo.access.level</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']//field[@name='role']"
                   position="attributes">
                <attribute name="string">Odoo Access Level</attribute>
            </xpath>
        </field>
    </record>
</odoo>
