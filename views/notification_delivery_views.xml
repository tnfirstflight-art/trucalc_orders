<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_notification_delivery_list" model="ir.ui.view">
        <field name="name">trucalc.notification.delivery.list</field>
        <field name="model">trucalc.notification.delivery</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-danger="state in ('permanent_failure', 'unknown')"
                  decoration-warning="state in ('pending', 'retryable_failure')"
                  decoration-success="state == 'sent'">
                <field name="order_number"/>
                <field name="company_id" string="Bank"/>
                <field name="recipient_user_id" string="Original Requestor"/>
                <field name="notification_type"/>
                <field name="state"/>
                <field name="attempt_count"/>
                <field name="enqueued_at"/>
                <field name="first_attempt_at" optional="hide"/>
                <field name="transport_accepted_at" optional="show"/>
                <field name="failure_category" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_trucalc_notification_delivery_form" model="ir.ui.view">
        <field name="name">trucalc.notification.delivery.form</field>
        <field name="model">trucalc.notification.delivery</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_reconciliation_wizard" type="object"
                            string="Reconcile Unknown" class="btn-primary"
                            groups="trucalc_orders.group_trucalc_admin"
                            invisible="state != 'unknown'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_number"/>
                            <field name="company_id" string="Bank"/>
                            <field name="recipient_user_id" string="Original Requestor"/>
                            <field name="notification_type"/>
                            <field name="channel"/>
                        </group>
                        <group>
                            <field name="enqueued_at"/>
                            <field name="first_attempt_at"/>
                            <field name="last_attempt_at"/>
                            <field name="transport_accepted_at"/>
                            <field name="attempt_count"/>
                            <field name="failure_category"/>
                            <field name="failure_stage"/>
                        </group>
                    </group>
                    <group string="Reconciliation" invisible="not reconciled_at">
                        <field name="reconciled_by_id"/>
                        <field name="reconciled_at"/>
                        <field name="reconciliation_action"/>
                        <field name="provider_reference"/>
                        <field name="reconciliation_reason"/>
                    </group>
                    <field name="audit_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="event_at"/>
                            <field name="audit_type"/>
                            <field name="attempt_number"/>
                            <field name="prior_state"/>
                            <field name="new_state"/>
                            <field name="failure_category"/>
                            <field name="actor_user_id"/>
                            <field name="evidence_reference"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trucalc_notification_delivery_search" model="ir.ui.view">
        <field name="name">trucalc.notification.delivery.search</field>
        <field name="model">trucalc.notification.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_number"/>
                <field name="company_id"/>
                <field name="recipient_user_id"/>
                <filter name="needs_attention" string="Needs Attention"
                        domain="[('state', 'in', ('permanent_failure', 'unknown', 'retryable_failure'))]"/>
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_bank" string="Bank" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_trucalc_notification_deliveries" model="ir.actions.act_window">
        <field name="name">Notification Deliveries</field>
        <field name="res_model">trucalc.notification.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_needs_attention': 1}</field>
    </record>

    <menuitem id="menu_trucalc_notification_deliveries"
              name="Notification Deliveries"
              parent="menu_trucalc_root"
              action="action_trucalc_notification_deliveries"
              sequence="20"
              groups="trucalc_orders.group_trucalc_admin,trucalc_orders.group_trucalc_operations"/>

    <record id="view_trucalc_notification_reconcile_wizard_form" model="ir.ui.view">
        <field name="name">trucalc.notification.reconcile.wizard.form</field>
        <field name="model">trucalc.notification.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="Reconcile Unknown Notification">
                <group>
                    <field name="delivery_id"/>
                    <field name="action"/>
                    <field name="accepted_at" invisible="action != 'confirmed_accepted'" required="action == 'confirmed_accepted'"/>
                    <field name="evidence_reference" required="action in ('confirmed_accepted', 'approved_resend')"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply Reconciliation"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
