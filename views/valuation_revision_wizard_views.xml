<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_valuation_revision_wizard_form" model="ir.ui.view">
        <field name="name">trucalc.valuation.revision.wizard.form</field>
        <field name="model">trucalc.valuation.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Valuation Revision">
                <group>
                    <field name="order_id"/>
                    <field name="target_valuation_id"/>
                    <field name="vendor_revision_instructions"
                           placeholder="Describe the corrections required from the Vendor..."/>
                </group>
                <footer>
                    <button name="action_request_revision" type="object"
                            string="Request Revision" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
