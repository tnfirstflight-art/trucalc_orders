<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trucalc_internal_user_provision_form" model="ir.ui.view">
        <field name="name">trucalc.internal.user.provision.form</field>
        <field name="model">trucalc.internal.user.provision</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <form string="Add TruCalc User" create="false" edit="true" delete="false">
                <group string="Identity">
                    <field name="name"/>
                    <field name="login"/>
                    <field name="phone"/>
                </group>
                <group string="TruCalc Role">
                    <field name="role" widget="radio"/>
                    <field name="reviewer"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Create User" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_trucalc_internal_user_new" model="ir.actions.act_window">
        <field name="name">Add TruCalc User</field>
        <field name="res_model">trucalc.internal.user.provision</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_trucalc_internal_user_provision_form"/>
        <field name="target">new</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
    </record>

    <record id="view_trucalc_internal_user_role_change_form" model="ir.ui.view">
        <field name="name">trucalc.internal.user.role.change.form</field>
        <field name="model">trucalc.internal.user.role.change</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <form string="Change TruCalc Role" create="false" edit="true" delete="false">
                <group>
                    <field name="target_user_id" options="{'no_open': True}"/>
                    <field name="role" widget="radio"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Change Role" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_trucalc_internal_user_deactivate_form" model="ir.ui.view">
        <field name="name">trucalc.internal.user.deactivate.form</field>
        <field name="model">trucalc.internal.user.deactivate</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <form string="Deactivate TruCalc User" create="false" edit="true" delete="false">
                <group>
                    <field name="target_user_id" options="{'no_open': True}"/>
                    <field name="open_activity_count" readonly="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not open_activity_count">
                        This user has open activities. They will remain assigned and will not be discarded or rewritten.
                    </div>
                    <field name="acknowledge_open_activities"
                           invisible="not open_activity_count"
                           required="open_activity_count"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Deactivate" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_trucalc_internal_user_manage_form" model="ir.ui.view">
        <field name="name">trucalc.internal.user.manage.form</field>
        <field name="model">trucalc.internal.user.manage</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <form string="Manage TruCalc User" create="false" edit="true" delete="false">
                <field name="owner_user_id" invisible="1"/>
                <field name="management_row_id" invisible="1"/>
                <field name="target_user_id" invisible="1"/>
                <field name="email_changed" invisible="1"/>
                <field name="pending_account_link" invisible="1"/>
                <field name="requires_link_acknowledgement" invisible="1"/>
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="internal_company_id" options="{'no_open': True}"/>
                            <field name="name" readonly="not user_active"/>
                            <field name="login" readonly="not user_active"
                                   placeholder="user@example.com"/>
                            <field name="phone" readonly="not user_active"/>
                        </group>
                        <group string="Access">
                            <field name="role" readonly="not user_active"/>
                            <field name="reviewer" readonly="not user_active"/>
                        </group>
                    </group>
                    <group string="Account Status" col="4">
                        <group>
                            <field name="user_active"/>
                            <field name="account_state"/>
                            <field name="last_login"/>
                        </group>
                        <group>
                            <field name="recent_email_kind"/>
                            <field name="recent_email_outcome"/>
                            <field name="recent_email_at"/>
                            <field name="recent_mail_state" optional="hide"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not requires_link_acknowledgement">
                        Changing the email will invalidate the current invitation or password-reset link.
                        Save first, then use the account action appropriate to the refreshed state.
                    </div>
                    <group invisible="not requires_link_acknowledgement">
                        <field name="acknowledge_account_link_invalidation"
                               required="requires_link_acknowledgement"/>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not user_active or not open_activity_count">
                        This user has open activities. They remain assigned on deactivation and must be acknowledged.
                    </div>
                    <group invisible="not user_active or not open_activity_count">
                        <field name="open_activity_count" readonly="1"/>
                        <field name="acknowledge_open_activities"/>
                    </group>
                    <group string="Account Actions">
                        <button name="action_send_invitation" type="object"
                                string="Send Invitation" class="btn-secondary"
                                invisible="account_state != 'never_invited'"/>
                        <button name="action_resend_invitation" type="object"
                                string="Resend Invitation" class="btn-secondary"
                                invisible="account_state not in ('invitation_pending', 'invitation_expired')"/>
                        <button name="action_send_password_reset" type="object"
                                string="Send Password Reset" class="btn-secondary"
                                invisible="account_state not in ('confirmed', 'reset_pending')"/>
                        <button name="action_reactivate" type="object"
                                string="Reactivate User" class="btn-secondary"
                                invisible="account_state != 'inactive'"/>
                        <button name="action_deactivate" type="object"
                                string="Deactivate User" class="btn-secondary"
                                invisible="not user_active"
                                confirm="Deactivate this TruCalc user? Existing Orders, reviews, activities, documents, and audit attribution will be preserved."/>
                    </group>
                    <notebook>
                        <page string="Administration History">
                            <field name="account_audit_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="event_at"/>
                                    <field name="event_type"/>
                                    <field name="actor_user_id"/>
                                    <field name="prior_role" optional="hide"/>
                                    <field name="new_role" optional="hide"/>
                                    <field name="mail_state" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save Changes"
                            class="btn-primary" invisible="not user_active"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_trucalc_internal_user_management_list" model="ir.ui.view">
        <field name="name">trucalc.internal.user.management.list</field>
        <field name="model">trucalc.internal.user.management</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <list string="TruCalc Users" create="false" edit="false" delete="false"
                  open_form_view="false">
                <header>
                    <button name="%(action_trucalc_internal_user_new)d" type="action"
                            string="Add TruCalc User" class="btn-primary" display="always"/>
                </header>
                <field name="owner_user_id" column_invisible="True"/>
                <field name="target_user_id" column_invisible="True"/>
                <field name="name" widget="trucalc_internal_user_manage_link"/>
                <field name="login"/>
                <field name="phone" string="Phone Number"/>
                <field name="role"/>
                <field name="reviewer"/>
                <field name="user_active"/>
                <field name="account_state"/>
            </list>
        </field>
    </record>

    <record id="view_trucalc_internal_user_management_form" model="ir.ui.view">
        <field name="name">trucalc.internal.user.management.form</field>
        <field name="model">trucalc.internal.user.management</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <form string="TruCalc User" create="false" edit="false" delete="false">
                <header>
                    <button name="action_send_invitation" type="object" string="Send Invitation"
                            class="btn-primary" invisible="not user_active or setup_link_prepared"/>
                    <button name="action_send_invitation" type="object" string="Resend Invitation"
                            class="btn-primary" invisible="not user_active or not setup_link_prepared"/>
                    <button name="action_change_role" type="object" string="Change Role"
                            invisible="not user_active"/>
                    <button name="action_add_reviewer" type="object" string="Add Reviewer"
                            invisible="not user_active or reviewer"/>
                    <button name="action_remove_reviewer" type="object" string="Remove Reviewer"
                            invisible="not user_active or not reviewer"/>
                    <button name="action_deactivate" type="object" string="Deactivate"
                            invisible="not user_active"/>
                    <button name="action_reactivate" type="object" string="Reactivate"
                            invisible="user_active"/>
                </header>
                <sheet>
                    <field name="owner_user_id" invisible="1"/>
                    <field name="target_user_id" invisible="1"/>
                    <field name="setup_link_prepared" invisible="1"/>
                    <group string="Identity">
                        <field name="name"/>
                        <field name="login"/>
                        <field name="phone"/>
                    </group>
                    <group string="TruCalc Role">
                        <field name="role"/>
                        <field name="reviewer"/>
                    </group>
                    <group string="Account Status">
                        <field name="user_active"/>
                        <field name="login_date"/>
                    </group>
                    <button name="action_view_audit" type="object"
                            string="Administration History" class="btn-secondary"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trucalc_internal_user_admin_audit_list" model="ir.ui.view">
        <field name="name">trucalc.internal.user.admin.audit.list</field>
        <field name="model">trucalc.internal.user.admin.audit</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <list string="TruCalc User Administration History" create="false" edit="false" delete="false">
                <field name="event_at"/>
                <field name="event_type"/>
                <field name="actor_user_id"/>
                <field name="target_user_id"/>
                <field name="prior_role" optional="hide"/>
                <field name="new_role" optional="hide"/>
                <field name="mail_state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_trucalc_internal_user_admin_audit_form" model="ir.ui.view">
        <field name="name">trucalc.internal.user.admin.audit.form</field>
        <field name="model">trucalc.internal.user.admin.audit</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
        <field name="arch" type="xml">
            <form string="TruCalc User Administration Event" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="event_at"/>
                        <field name="event_type"/>
                        <field name="actor_user_id"/>
                        <field name="target_user_id"/>
                        <field name="normalized_identity"/>
                    </group>
                    <group string="State">
                        <field name="prior_role"/>
                        <field name="new_role"/>
                        <field name="prior_reviewer"/>
                        <field name="new_reviewer"/>
                        <field name="prior_active"/>
                        <field name="new_active"/>
                        <field name="reused_identity"/>
                    </group>
                    <group string="Invitation">
                        <field name="mail_id" options="{'no_open': True}"/>
                        <field name="mail_state"/>
                    </group>
                    <field name="metadata" widget="json"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trucalc_internal_users" model="ir.actions.server">
        <field name="name">TruCalc Users</field>
        <field name="model_id" ref="model_trucalc_internal_user_management"/>
        <field name="state">code</field>
        <field name="code">action = model._trucalc_open()</field>
        <field name="group_ids" eval="[Command.link(ref('trucalc_orders.group_trucalc_admin'))]"/>
    </record>

    <menuitem id="menu_trucalc_internal_users" name="TruCalc Users"
              parent="menu_trucalc_configuration"
              action="action_trucalc_internal_users" sequence="20"
              groups="trucalc_orders.group_trucalc_admin"/>
</odoo>
